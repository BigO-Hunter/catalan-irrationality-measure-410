theorem rowPosTop (C : CellsQ2) : ∀ ε : ℝ, 0 < ε → ∀ᶠ N : ℕ in atTop, ∀ x ∈ Ioo (0 : ℝ) 1, (999 / 1000 : ℝ) ≤ x →
