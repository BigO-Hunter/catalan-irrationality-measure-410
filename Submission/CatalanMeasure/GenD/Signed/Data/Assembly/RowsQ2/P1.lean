    funext y; simp only [rmQ]; push_cast; ring
  have hσ : ((20 : ℝ) / 58) = ((10 / 29 : ℚ) : ℝ) := by push_cast; norm_num
  rw [e, ← bs_eq] at h
  have hpf : poleFn (fqB α).poles = poleF (fqB α).poles := rfl
  rw [hpf] at h
  simp only [posLim]
  rw [hσ]
