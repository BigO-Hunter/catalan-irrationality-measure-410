  rw [Real.log_pow, one_div, Real.log_inv] at h3
  have := Real.log_two_gt_d9
  have hk0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  nlinarith

/-- **`hSp` of trial 2.** -/
theorem rowSP (C : CellsQ2) : ∀ ε : ℝ, 0 < ε → ∀ᶠ N : ℕ in atTop, ∀ x ∈ Ioo (0 : ℝ) 1,
