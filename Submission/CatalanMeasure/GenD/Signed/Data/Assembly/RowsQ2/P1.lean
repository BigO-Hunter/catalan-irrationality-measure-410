  have hK := spK_le_2
  have hcs : (X2.CSP : ℝ) / 58 = ((X2.CSP / 58 : ℚ) : ℝ) := by push_cast; ring
  -- the five budget comparisons
  have hS0 : (((TR0 : ℝ) + (U0 : ℝ) + (l0Const q2spiTsM ((1 : ℚ) / 2 ^ 20) 27 : ℝ)) + (((1 : ℚ) / 2 ^ 85 : ℚ) : ℝ) +
      spK T2.trial + ((endC q2spiFq [] 0 + l0C q2spiTsM : ℚ) : ℝ) * Real.log (((1 : ℚ) / 2 ^ 20) : ℝ)) ≤ (-917526653 / 536870912 : ℝ) := by
    have hl := log_le_neg (y := (((1 : ℚ) / 2 ^ 20 : ℚ) : ℝ)) (m := 20) (by norm_num) (by norm_num)
    have hc : (0 : ℝ) ≤ ((endC q2spiFq [] 0 + l0C q2spiTsM : ℚ) : ℝ) := by exact_mod_cast hc0.le
    have hm := mul_le_mul_of_nonneg_left hl hc
