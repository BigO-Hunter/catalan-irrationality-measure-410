/-- The near corner field of trial 1. -/
abbrev fqN (α β : ℚ) : FieldQ := nearFQ T1.trial (rnFQ (53 / 58) (24 / 29)) T1.aS T1.rS T1.bS (10 / 29) α β
abbrev cM (β : ℚ) : ℚ := β / (4 * (1 - T1.trial.η))
abbrev TsN : List LTerm := scaleL (-1) (reflL (dilTermsS T1.trial.qF T1.trial.qFn))

theorem nearLim_q (α β : ℚ) : ∀ x ∈ Ioo (0 : ℝ) 1, nearLim X1 α β x =
    fieldTower (fqN α β) (poleF (fqN α β).poles) 0 x + lfieldTower TsN 0 x + nearK T1.trial α β +
      (X1.CSP : ℝ) / 58 * (if 1 - 1 / 1024 < x then 1 else 0) := by
  intro x hx
  have h := hid_near T1.trial (fun y => (fval_rn (53 / 58) (24 / 29) y).symm) T1.aS_eq T1.rS_eq T1.bS_eq
    rfl T1.har (σ := 10 / 29) (α := α) (β := β) (csL := (X1.CSP : ℝ) / 58) (θL := 1 / 1024)
    (fq := fqN α β) rfl hx
  have hR : (fun y : ℝ => -((53 : ℝ) / 58) * Real.log (1 + y ^ 2) + (24 / 29) * Real.log |y|) =
      rnQ (53 / 58) (24 / 29) := by
    funext y; simp only [rnQ]; push_cast; ring
  have hσ : ((20 : ℝ) / 58) = ((10 / 29 : ℚ) : ℝ) := by push_cast; norm_num
  have e : nearLim X1 α β x = fNearMSLim T1.trial.form (rnQ (53 / 58) (24 / 29)) (α : ℝ) (β : ℝ)
      ((10 / 29 : ℚ) : ℝ) (fQ T1.bsL) T1.bsL.length ((X1.CSP : ℝ) / 58) (1 / 1024) x := by
    rw [← hσ, ← hR, ← bs_eq]
    rfl
  rw [e, h]
  rfl

/-- A near interior corner from its cell statement. -/
theorem corner (α β : ℚ) {a b : ℝ} (ha : ((α : ℚ) : ℝ) = a) (hb : ((β : ℚ) : ℝ) = b) (Fc : FieldQ) (T δ : ℚ) (hpl : (fqN α β).plogs = Fc.plogs) (hpo : (fqN α β).poles = Fc.poles)
    (hδ : l1Q (fqN α β).poly Fc.poly ≤ δ)
    (hs : ∀ x ∈ Icc (401 / 2500 : ℝ) (999 / 1000), fieldTower Fc (poleF Fc.poles) 0 x + lfieldTower TsN 0 x ≤ (T : ℝ)) :
    ∀ x ∈ Ico (401 / 2500 : ℝ) (999 / 1000), nearLim X1 a b x ≤ (T : ℝ) + δ + nearK T1.trial α β := by
  subst ha hb
  intro x hx
  have hx01 : x ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hx.1], by linarith [hx.2]⟩
  have hc := fieldTower_le_cell (fqN α β) Fc hpl hpo hδ (x := x)
    (by rw [abs_le]; constructor <;> linarith [hx01.1, hx01.2]) poleF
  have h1 := hs x ⟨hx.1, hx.2.le⟩
  have hsp : (if 1 - 1 / 1024 < x then (1 : ℝ) else 0) = 0 := if_neg (by linarith [hx.2])
  rw [nearLim_q α β x hx01, hsp]
  linarith

theorem top_split (α β : ℚ) (Ft : FieldQ) (hpl : (fqN α β).plogs = Ft.plogs ++ (fqScale (cM β) m1sqFQ).plogs)
    {x : ℝ} (hx : x ∈ Ioo (-1 : ℝ) 1) :
    fieldTower (fqN α β) (poleF (fqN α β).poles) 0 x =
      fieldTower ⟨(fqN α β).poly, Ft.plogs, (fqN α β).poles⟩ (poleF (fqN α β).poles) 0 x +
        ((cM β : ℚ) : ℝ) * (-Real.log (1 - x ^ 2)) := by
  have hm : plogSumTower (fqScale (cM β) m1sqFQ).plogs 0 x = fval (fqScale (cM β) m1sqFQ) x := by
    simp [fval, fqScale, m1sqFQ, polyTow, poleFn]
  unfold fieldTower
  simp only
  rw [hpl, l1_plogSum_append, hm, fval_scale, fval_m1sq hx]
  ring

/-- A near top corner from its two top cell statements. -/
theorem top_corner (α β : ℚ) {a b c : ℝ} (ha : ((α : ℚ) : ℝ) = a) (hb : ((β : ℚ) : ℝ) = b)
    (hcm : ((cM β : ℚ) : ℝ) = c) (Ft : FieldQ) (T TJ δ : ℚ)
    (hpl : (fqN α β).plogs = Ft.plogs ++ (fqScale (cM β) m1sqFQ).plogs) (hpo : (fqN α β).poles = Ft.poles)
    (hδ : l1Q (fqN α β).poly Ft.poly ≤ δ)
    (hS : ∀ x ∈ Icc (999 / 1000 : ℝ) (1 - 1 / 1024), fieldTower Ft (poleF Ft.poles) 0 x + lfieldTower TsN 0 x ≤ (T : ℝ))
    (hJ : ∀ x ∈ Icc (1 - 1 / 1024 : ℝ) 1, fieldTower Ft (poleF Ft.poles) 0 x + lfieldTower TsN 0 x ≤ (TJ : ℝ)) :
    ∀ x ∈ Ico (999 / 1000 : ℝ) 1, nearLim X1 a b x ≤
      max ((T : ℝ) + δ + nearK T1.trial α β) ((TJ : ℝ) + δ + nearK T1.trial α β + (X1.CSP : ℝ) / 58) +
        c * (-Real.log (1 - x ^ 2)) := by
  subst ha hb hcm
  intro x hx
  have hx01 : x ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hx.1], hx.2⟩
  rw [nearLim_q α β x hx01, top_split α β Ft hpl ⟨by linarith [hx.1], hx.2⟩]
  have hc := fieldTower_le_cell ⟨(fqN α β).poly, Ft.plogs, (fqN α β).poles⟩ Ft rfl hpo hδ
    (x := x) (by rw [abs_le]; constructor <;> linarith [hx01.1, hx01.2]) poleF
  rcases le_or_gt x (1 - 1 / 1024) with h1 | h1
  · have := hS x ⟨hx.1, h1⟩
    rw [if_neg (by linarith : ¬ (1 - 1 / 1024 < x))]
    have := le_max_left ((T : ℝ) + δ + nearK T1.trial α β) ((TJ : ℝ) + δ + nearK T1.trial α β + (X1.CSP : ℝ) / 58)
    linarith
  · have := hJ x ⟨h1.le, hx.2.le⟩
    rw [if_pos h1]
    have := le_max_right ((T : ℝ) + δ + nearK T1.trial α β) ((TJ : ℝ) + δ + nearK T1.trial α β + (X1.CSP : ℝ) / 58)
    linarith

