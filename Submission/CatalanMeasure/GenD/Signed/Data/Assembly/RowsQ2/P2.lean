  have hrc : remC (1 / 10) = ((11 / 8 : ℚ) : ℝ) := by unfold remC; push_cast; norm_num
  have key := rowPos_cell X2 hok hRt (by norm_num) (by norm_num) (by norm_num)
    (fqB (1 / 200)) (fqB (1 / 16)) q2spmraFq q2spmrbFq (dilTermsS T2.trial.qT T2.trial.qTn)
    (hFtα (1 / 200)) (hFtα (1 / 16)) pl_a po_a l1_a pl_b po_b l1_b
