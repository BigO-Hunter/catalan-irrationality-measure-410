/-! ### Structural assembly: the jobs and their log forms -/

theorem jobs_eq : refPlan Rm1 Rm2 =
    [⟨qaT, qbT, false, (-1)⟩,
     ⟨qaT, qbF0, true, (-1)⟩,
     ⟨qaT, qbF1, true, (-1)⟩,
     ⟨qaF0, qbT, true, (-1)⟩,
     ⟨qaF1, qbT, true, (-1)⟩,
     ⟨qaF0, qbF0, false, (-1)⟩,
     ⟨qaF0, qbF1, false, (-1)⟩,
     ⟨qaF1, qbF0, false, (-1)⟩,
     ⟨qaF1, qbF1, false, (-1)⟩] := by rfl

theorem planLits_eq : planLits Rm1 Rm2 = [L1, L2, L3, L4, L5, L6, L7, L8, L9] := by
  simp only [planLits, jobs_eq, List.map_cons, List.map_nil,
    job1, job2, job3, job4, job5, job6, job7, job8, job9]


/-! ### `LF.sumL` of the literal log forms -/

theorem c0_sumL : ∀ l : List LF, (LF.sumL l).c0 = (l.map (fun f => f.c0)).sum
  | [] => rfl
  | f :: l => by
    simp only [LF.sumL, LF.add, List.map_cons, List.sum_cons, c0_sumL l]

theorem ts_sumL : ∀ l : List LF, (LF.sumL l).ts = l.flatMap (fun f => f.ts)
  | [] => rfl
  | f :: l => by
    simp only [LF.sumL, LF.add, List.flatMap_cons, ts_sumL l]

