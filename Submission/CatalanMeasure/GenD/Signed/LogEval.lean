module

public import Mathlib.Analysis.Real.Pi.Bounds
public import Mathlib.Analysis.Complex.ExponentialBounds
public import Submission.CatalanMeasure.GenD.Cert.WLog
public import Submission.CatalanMeasure.GenD.Signed.TaylorCell

@[expose] public section

/-!
# Certified evaluation of the cell anchors `A0` (Theorem A, Phase 2)

Rational enclosures `(v, e)` with `|true value - v| <= e` of

* `Real.log q`, `Real.log |q|` for rational `q` (`logQ`, `logAbsQ`),
* `Complex.arg (a + b i)` (`argQ`) and the real part of a weighted complex logarithm
  `Re[rho log (x - p)]` (`reClogQ`),

at about 2^-124, from kernel-checked node tables `log (1 + j/256)` and `arctan (j/128)` at scale
`2^-128` (checked once, `lnChk_all`, `atChk_all`) and a Machin value of `pi/4`.  This is the
precision of `WLog` (`2^-95`) raised by 33 bits: the Legendre-potential pieces of the Phase 2
fields cancel about 6e15 against the polynomial part (NOTES-DATA, Stage A, finding 1), so the
log values need about 110 bits.  The series/tail lemmas are those of `WLog`.

* section 3: sums of weighted terms, dyadic grid rounding at declaration boundaries;
* section 4: the point-value chaining lemma (`F` at the next centre from the Taylor expansion at
  the previous one);
* section 5: transfer lemmas for dyadic-normalised literals (Nat low-64-bit hash collisions).
-/

open CatalanMeasure.Cert OAI.InternalCatalan
open CatalanMeasure.WLog (serH serH_spec atanh_tail atan_tail)
open CatalanMeasure.CellCert (PoleR qt qabs' qabs'_cast)
namespace CatalanMeasure.GenD.Signed.LogEval

/-! ## 1. Node tables at scale `2^-128` (slot width 132 bits), generated by `gen_tables.py` -/

def LNT : ℕ := 
def ATT : ℕ := 
def PI4N : ℕ := 267257146016241686964920093290467695825

def lnTab (j : ℕ) : ℚ := (((LNT >>> (132 * j)) % 2 ^ 132 : ℕ) : ℚ) / 2 ^ 128
def atTab (j : ℕ) : ℚ := (((ATT >>> (132 * j)) % 2 ^ 132 : ℕ) : ℚ) / 2 ^ 128

/-- `lnTab j` is within `2^-128` of the 44-term `atanh` series for `log (1 + j/256)` -/
def lnChk (j : ℕ) : Bool :=
  let x : ℚ := (j : ℚ) / (512 + j)
  decide (qabs (lnTab j - 2 * x * serH (x ^ 2) 44 1) ≤ 1 / 2 ^ 128)

/-- `atTab j` is within `2^-128` of the 65-term series for `arctan (j/128)` -/
def atChk (j : ℕ) : Bool :=
  let x : ℚ := (j : ℚ) / 128
  decide (qabs (atTab j - x * serH (-(x ^ 2)) 65 1) ≤ 1 / 2 ^ 128)

theorem lnChk_all : ∀ j < 257, lnChk j = true := by decide +kernel
theorem atChk_all : ∀ j < 65, atChk j = true := by decide +kernel

theorem lnTab_spec {j : ℕ} (hj : j ≤ 256) :
    |Real.log (1 + (j : ℝ) / 256) - (lnTab j : ℝ)| ≤ 1 / 2 ^ 127 := by
  have hc := lnChk_all j (by omega)
  simp only [lnChk, decide_eq_true_eq, qabs_eq] at hc
  have hjR : (j : ℝ) ≤ 256 := by exact_mod_cast hj
  have hj0 : (0 : ℝ) ≤ j := by positivity
  have hS := serH_spec (((j : ℚ) / (512 + j)) ^ 2) 44 1
  have hc0 : ((qabs (lnTab j - 2 * ((j : ℚ) / (512 + j)) * serH (((j : ℚ) / (512 + j)) ^ 2) 44 1) : ℚ) : ℝ)
      ≤ ((1 / 2 ^ 128 : ℚ) : ℝ) := Rat.cast_le.mpr (by simpa [qabs_eq] using hc)
  rw [qabs_eq, Rat.cast_abs] at hc0
  have hc' := hc0
  push_cast at hc'
  rw [hS] at hc'
  push_cast at hc'
  set x : ℝ := (j : ℝ) / (512 + j) with hx
  have hx0 : 0 ≤ x := by positivity
  have hx3 : x ≤ 1 / 3 := by rw [hx, div_le_iff₀ (by positivity)]; linarith
  have hxy : (1 + x) / (1 - x) = 1 + (j : ℝ) / 256 := by
    rw [hx]; field_simp; ring
  have ht := atanh_tail hx0 (by linarith) 44
  rw [hxy] at ht
  have h65 : x ^ (2 * 44 + 1) ≤ (1 / 3) ^ (2 * 44 + 1) := pow_le_pow_left₀ hx0 hx3 _
  have hden : (8 : ℝ) / 9 ≤ 1 - x ^ 2 := by nlinarith
  have htail : 2 * x ^ (2 * 44 + 1) / (1 - x ^ 2) ≤ 1 / 2 ^ 130 := by
    calc 2 * x ^ (2 * 44 + 1) / (1 - x ^ 2) ≤ 2 * (1 / 3) ^ (2 * 44 + 1) / (8 / 9) := by
          apply div_le_div₀ (by positivity) (by linarith) (by norm_num) hden
      _ ≤ 1 / 2 ^ 130 := by norm_num
  have e : Real.log (1 + (j : ℝ) / 256) - (lnTab j : ℝ) =
      (Real.log (1 + (j : ℝ) / 256) -
        2 * x * ∑ i ∈ Finset.range 44, (x ^ 2) ^ i / ((1 + 2 * i : ℕ) : ℝ)) +
      (2 * x * ∑ i ∈ Finset.range 44, (x ^ 2) ^ i / ((1 + 2 * i : ℕ) : ℝ) - (lnTab j : ℝ)) := by ring
  rw [e]
  have h2 := abs_add_le (Real.log (1 + (j : ℝ) / 256) -
        2 * x * ∑ i ∈ Finset.range 44, (x ^ 2) ^ i / ((1 + 2 * i : ℕ) : ℝ))
      (2 * x * ∑ i ∈ Finset.range 44, (x ^ 2) ^ i / ((1 + 2 * i : ℕ) : ℝ) - (lnTab j : ℝ))
  have hc2 : |2 * x * ∑ i ∈ Finset.range 44, (x ^ 2) ^ i / ((1 + 2 * i : ℕ) : ℝ) - (lnTab j : ℝ)| ≤ 1 / 2 ^ 128 := by
    rw [abs_sub_comm]; push_cast; exact hc'
  have : (1 : ℝ) / 2 ^ 130 + 1 / 2 ^ 128 ≤ 1 / 2 ^ 127 := by norm_num
  linarith [h2, ht, htail, hc2, this]

theorem atTab_spec {j : ℕ} (hj : j ≤ 64) :
    |Real.arctan ((j : ℝ) / 128) - (atTab j : ℝ)| ≤ 1 / 2 ^ 127 := by
  have hc := atChk_all j (by omega)
  simp only [atChk, decide_eq_true_eq, qabs_eq] at hc
  have hjR : (j : ℝ) ≤ 64 := by exact_mod_cast hj
  have hj0 : (0 : ℝ) ≤ j := by positivity
  have hS := serH_spec (-(((j : ℚ) / 128) ^ 2)) 65 1
  have hc0 : ((qabs (atTab j - ((j : ℚ) / 128) * serH (-(((j : ℚ) / 128) ^ 2)) 65 1) : ℚ) : ℝ)
      ≤ ((1 / 2 ^ 128 : ℚ) : ℝ) := Rat.cast_le.mpr (by simpa [qabs_eq] using hc)
  rw [qabs_eq, Rat.cast_abs] at hc0
  have hc' := hc0
  push_cast at hc'
  rw [hS] at hc'
  push_cast at hc'
  set x : ℝ := (j : ℝ) / 128 with hx
  have hx0 : 0 ≤ x := by positivity
  have hx3 : x ≤ 1 / 2 := by rw [hx, div_le_iff₀ (by positivity)]; linarith
  have ht := atan_tail hx0 (by linarith) 65
  have h65 : x ^ (2 * 65 + 1) ≤ (1 / 2) ^ (2 * 65 + 1) := pow_le_pow_left₀ hx0 hx3 _
  have hden : (3 : ℝ) / 4 ≤ 1 - x ^ 2 := by nlinarith
  have htail : x ^ (2 * 65 + 1) / (1 - x ^ 2) ≤ 1 / 2 ^ 130 := by
    calc x ^ (2 * 65 + 1) / (1 - x ^ 2) ≤ (1 / 2) ^ (2 * 65 + 1) / (3 / 4) := by
          apply div_le_div₀ (by positivity) h65 (by norm_num) hden
      _ ≤ 1 / 2 ^ 130 := by norm_num
  have e : Real.arctan x - (atTab j : ℝ) =
      (Real.arctan x - x * ∑ i ∈ Finset.range 65, (-(x ^ 2)) ^ i / ((1 + 2 * i : ℕ) : ℝ)) +
      (x * ∑ i ∈ Finset.range 65, (-(x ^ 2)) ^ i / ((1 + 2 * i : ℕ) : ℝ) - (atTab j : ℝ)) := by ring
  rw [e]
  have h2 := abs_add_le (Real.arctan x - x * ∑ i ∈ Finset.range 65, (-(x ^ 2)) ^ i / ((1 + 2 * i : ℕ) : ℝ))
      (x * ∑ i ∈ Finset.range 65, (-(x ^ 2)) ^ i / ((1 + 2 * i : ℕ) : ℝ) - (atTab j : ℝ))
  have hc2 : |x * ∑ i ∈ Finset.range 65, (-(x ^ 2)) ^ i / ((1 + 2 * i : ℕ) : ℝ) - (atTab j : ℝ)| ≤ 1 / 2 ^ 128 := by
    rw [abs_sub_comm]; push_cast; exact hc'
  have : (1 : ℝ) / 2 ^ 130 + 1 / 2 ^ 128 ≤ 1 / 2 ^ 127 := by norm_num
  linarith [h2, ht, htail, hc2, this]

/-! ## 2. Rational enclosures of log, arctan, arg -/

theorem two_zpow_pred (q : ℚ) (m : ℤ) : q / 2 ^ (m - 1) = 2 * (q / 2 ^ m) := by
  rw [zpow_sub₀ (by norm_num), zpow_one]
  field_simp

/-- `(m, y)` with `y = q / 2^m ∈ [1,2]`: one division and one comparison pair -/
def findExpY (q : ℚ) : Option (ℤ × ℚ) :=
  let m0 : ℤ := (q.num.natAbs.log2 : ℤ) - (q.den.log2 : ℤ)
  let y0 : ℚ := q / 2 ^ m0
  if 1 ≤ y0 ∧ y0 ≤ 2 then some (m0, y0)
  else if 1 ≤ 2 * y0 ∧ 2 * y0 ≤ 2 then some (m0 - 1, 2 * y0) else none

theorem findExpY_spec {q y : ℚ} {m : ℤ} (h : findExpY q = some (m, y)) :
    y = q / 2 ^ m ∧ 1 ≤ y ∧ y ≤ 2 := by
  unfold findExpY at h
  simp only at h
  split_ifs at h with h1 h2
  · simp only [Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact ⟨rfl, h1.1, h1.2⟩
  · simp only [Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    refine ⟨?_, h2.1, h2.2⟩
    exact (two_zpow_pred q _).symm

/-- `Real.log (2^m y)` for `y ∈ [1,2]`: node `1 + j/256`, `atanh` series (integer arithmetic for `j, w`) -/
def lnQy (n : ℕ) (y : ℚ) (m : ℤ) : Option (ℚ × ℚ) :=
  let j : ℕ := ((y.num - y.den) * 256 / (y.den : ℤ)).toNat
  let N : ℤ := 256 * y.num - (256 + (j : ℤ)) * y.den
  let D : ℤ := 256 * y.num + (256 + (j : ℤ)) * y.den
  if j ≤ 256 ∧ 0 ≤ N ∧ 0 < D ∧ 512 * N ≤ D then
    let w : ℚ := (N : ℚ) / (D : ℚ)
    some ((m : ℚ) * lnTab 256 + lnTab j + 2 * w * serH (w ^ 2) n 1,
      ((qabs (m : ℚ)) + 1) * (1 / 2 ^ 127) + 2 * (1 / 512) ^ (2 * n + 1) / (1 - (1 / 512) ^ 2))
  else none

theorem lnQy_spec {n : ℕ} {y v e : ℚ} {m : ℤ} (hy1 : 1 ≤ y) (hy2 : y ≤ 2)
    (h : lnQy n y m = some (v, e)) :
    |Real.log ((2 : ℝ) ^ m * (y : ℝ)) - (v : ℝ)| ≤ (e : ℝ) := by
  unfold lnQy at h
  simp only at h
  split_ifs at h with hc
  · simp only [Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    obtain ⟨hj, hN0, hD0, hND⟩ := hc
    set j : ℕ := ((y.num - y.den) * 256 / (y.den : ℤ)).toNat with hjdef
    set N : ℤ := 256 * y.num - (256 + (j : ℤ)) * y.den with hNdef
    set D : ℤ := 256 * y.num + (256 + (j : ℤ)) * y.den with hDdef
    set w : ℚ := (N : ℚ) / (D : ℚ) with hwdef
    have hyR1 : (1 : ℝ) ≤ (y : ℝ) := by exact_mod_cast hy1
    have hjR : (j : ℝ) ≤ 256 := by exact_mod_cast hj
    have hj0 : (0 : ℝ) ≤ j := by positivity
    set yj : ℝ := 1 + (j : ℝ) / 256 with hyjdef
    have hyj1 : (1 : ℝ) ≤ yj := by rw [hyjdef]; linarith [div_nonneg hj0 (by norm_num : (0:ℝ) ≤ 256)]
    have hyj0 : yj ≠ 0 := ne_of_gt (by linarith)
    have hlogq : Real.log ((2 : ℝ) ^ m * (y : ℝ)) = (m : ℝ) * Real.log 2 + Real.log (y : ℝ) := by
      rw [Real.log_mul (by positivity) (by linarith), Real.log_zpow]
    have hDR : (0 : ℝ) < (D : ℝ) := by exact_mod_cast hD0
    have hNR : (0 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN0
    have hw0R : (0 : ℝ) ≤ (w : ℝ) := by
      rw [hwdef]; push_cast; exact div_nonneg hNR hDR.le
    have hw1R : (w : ℝ) ≤ 1 / 512 := by
      rw [hwdef]; push_cast
      rw [div_le_iff₀ hDR]
      have : (512 : ℝ) * N ≤ D := by exact_mod_cast hND
      linarith
    have hyd : (y : ℝ) = (y.num : ℝ) / (y.den : ℝ) := by
      rw [Rat.cast_def]
    have hdenR : (0 : ℝ) < (y.den : ℝ) := by exact_mod_cast y.den_pos
    have hwR : (w : ℝ) = ((y : ℝ) - yj) / ((y : ℝ) + yj) := by
      have h1 : (y : ℝ) + yj ≠ 0 := by linarith
      rw [hwdef]; push_cast
      rw [div_eq_div_iff (ne_of_gt hDR) h1, hNdef, hDdef, hyd, hyjdef]
      push_cast
      field_simp
    have hratio : (1 + (w : ℝ)) / (1 - (w : ℝ)) = (y : ℝ) / yj := by
      have h3 : (1 : ℝ) - (w : ℝ) ≠ 0 := ne_of_gt (by linarith)
      have h1 : (y : ℝ) + yj ≠ 0 := by linarith
      rw [div_eq_div_iff h3 hyj0, hwR]
      field_simp
      ring
    have hlogy : Real.log (y : ℝ) = Real.log yj + Real.log ((1 + (w : ℝ)) / (1 - (w : ℝ))) := by
      rw [hratio, ← Real.log_mul hyj0 (by positivity)]
      congr 1
      field_simp
    have hat := atanh_tail hw0R (by linarith) n
    have hS := serH_spec (w ^ 2) n 1
    have hT1 := lnTab_spec hj
    have hT2 := lnTab_spec (le_refl 256)
    rw [← hyjdef] at hT1
    have h2 : (1 : ℝ) + ((256 : ℕ) : ℝ) / 256 = 2 := by norm_num
    rw [h2] at hT2
    have hmono : 2 * (w : ℝ) ^ (2 * n + 1) / (1 - (w : ℝ) ^ 2) ≤
        2 * (1 / 512 : ℝ) ^ (2 * n + 1) / (1 - (1 / 512 : ℝ) ^ 2) := by
      apply div_le_div₀ (by positivity) _ (by norm_num) _
      · have := pow_le_pow_left₀ hw0R hw1R (2 * n + 1); linarith
      · have : (w : ℝ) ^ 2 ≤ (1 / 512 : ℝ) ^ 2 := pow_le_pow_left₀ hw0R hw1R 2
        linarith
    have hm_abs : ((qabs (m : ℚ) : ℚ) : ℝ) = |(m : ℝ)| := by
      rw [qabs_eq]; push_cast; rfl
    push_cast
    rw [hm_abs]
    have hsum : ((serH (w ^ 2) n 1 : ℚ) : ℝ) =
        ∑ i ∈ Finset.range n, ((w : ℝ) ^ 2) ^ i / ((1 + 2 * i : ℕ) : ℝ) := by
      rw [hS]; push_cast; rfl
    have hsum' : (2 : ℝ) * (w : ℝ) * ((serH (w ^ 2) n 1 : ℚ) : ℝ) =
        2 * (w : ℝ) * ∑ i ∈ Finset.range n, ((w : ℝ) ^ 2) ^ i / ((1 + 2 * i : ℕ) : ℝ) := by rw [hsum]
    have hmabs : |(m : ℝ) * (Real.log 2 - (lnTab 256 : ℝ))| ≤ |(m : ℝ)| * (1 / 2 ^ 127) := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left hT2 (abs_nonneg _)
    have e : Real.log ((2 : ℝ) ^ m * (y : ℝ)) - ((m : ℝ) * (lnTab 256 : ℝ) + (lnTab j : ℝ) +
        2 * (w : ℝ) * ((serH (w ^ 2) n 1 : ℚ) : ℝ)) =
        (m : ℝ) * (Real.log 2 - (lnTab 256 : ℝ)) + (Real.log yj - (lnTab j : ℝ)) +
        (Real.log ((1 + (w : ℝ)) / (1 - (w : ℝ))) -
          2 * (w : ℝ) * ∑ i ∈ Finset.range n, ((w : ℝ) ^ 2) ^ i / ((1 + 2 * i : ℕ) : ℝ)) := by
      rw [hlogq, hlogy, hsum']; ring
    rw [e]
    have t1 := abs_add_le ((m : ℝ) * (Real.log 2 - (lnTab 256 : ℝ)) + (Real.log yj - (lnTab j : ℝ)))
      (Real.log ((1 + (w : ℝ)) / (1 - (w : ℝ))) -
          2 * (w : ℝ) * ∑ i ∈ Finset.range n, ((w : ℝ) ^ 2) ^ i / ((1 + 2 * i : ℕ) : ℝ))
    have t2 := abs_add_le ((m : ℝ) * (Real.log 2 - (lnTab 256 : ℝ))) (Real.log yj - (lnTab j : ℝ))
    nlinarith [t1, t2, hmabs, hT1, hat, hmono]

/-- `Real.arctan t` for `t ≥ 0`: node `j/128`, then the `arctan` series on the residual -/
def atanPos (n : ℕ) (tn : ℚ) : Option (ℚ × ℚ) :=
  let j := (tn * 128).floor.toNat
  let tj : ℚ := (j : ℚ) / 128
  let s := (tn - tj) / (1 + tn * tj)
  if j ≤ 64 ∧ 0 ≤ s ∧ s ≤ 1 / 128 then
    some (atTab j + s * serH (-(s ^ 2)) n 1,
      1 / 2 ^ 127 + (1 / 128) ^ (2 * n + 1) / (1 - (1 / 128) ^ 2))
  else none

theorem atanPos_spec {n : ℕ} {tn v e : ℚ} (htn : 0 ≤ tn) (h : atanPos n tn = some (v, e)) :
    |Real.arctan (tn : ℝ) - (v : ℝ)| ≤ (e : ℝ) := by
  unfold atanPos at h
  simp only at h
  split_ifs at h with hc
  simp only [Option.some.injEq, Prod.mk.injEq] at h
  obtain ⟨rfl, rfl⟩ := h
  obtain ⟨hj, hs0, hs1⟩ := hc
  set j : ℕ := (tn * 128).floor.toNat with hjdef
  set tj : ℚ := (j : ℚ) / 128 with htj
  set s : ℚ := (tn - tj) / (1 + tn * tj) with hsdef
  have htn0 : (0 : ℝ) ≤ (tn : ℝ) := by exact_mod_cast htn
  have hj0 : (0 : ℝ) ≤ j := by positivity
  have htj0 : (0 : ℝ) ≤ (tj : ℝ) := by rw [htj]; push_cast; positivity
  have hs0R : (0 : ℝ) ≤ (s : ℝ) := by exact_mod_cast hs0
  have hs1R : (s : ℝ) ≤ 1 / 128 := by
    have h := (Rat.cast_le (K := ℝ)).mpr hs1
    push_cast at h; exact h
  have hsR : (s : ℝ) = ((tn : ℝ) - (tj : ℝ)) / (1 + (tn : ℝ) * (tj : ℝ)) := by
    rw [hsdef]; push_cast; ring
  have hadd := Real.arctan_add (x := (tn : ℝ)) (y := -(tj : ℝ)) (by nlinarith)
  rw [Real.arctan_neg] at hadd
  have hsq : ((tn : ℝ) + -(tj : ℝ)) / (1 - (tn : ℝ) * -(tj : ℝ)) = (s : ℝ) := by
    rw [hsR]; ring_nf
  rw [hsq] at hadd
  have hT := atTab_spec hj
  have htjR : (tj : ℝ) = (j : ℝ) / 128 := by rw [htj]; push_cast; ring
  rw [← htjR] at hT
  have hat := atan_tail hs0R (by linarith) n
  have hS := serH_spec (-(s ^ 2)) n 1
  have hsum : ((serH (-(s ^ 2)) n 1 : ℚ) : ℝ) =
      ∑ i ∈ Finset.range n, (-((s : ℝ) ^ 2)) ^ i / ((1 + 2 * i : ℕ) : ℝ) := by
    rw [hS]; push_cast; rfl
  have hmono : (s : ℝ) ^ (2 * n + 1) / (1 - (s : ℝ) ^ 2) ≤
      (1 / 128 : ℝ) ^ (2 * n + 1) / (1 - (1 / 128 : ℝ) ^ 2) := by
    apply div_le_div₀ (by positivity) _ (by norm_num) _
    · exact pow_le_pow_left₀ hs0R hs1R (2 * n + 1)
    · have : (s : ℝ) ^ 2 ≤ (1 / 128 : ℝ) ^ 2 := pow_le_pow_left₀ hs0R hs1R 2
      linarith
  push_cast
  rw [hsum]
  have e : Real.arctan (tn : ℝ) - ((atTab j : ℝ) + (s : ℝ) * ∑ i ∈ Finset.range n, (-((s : ℝ) ^ 2)) ^ i / ((1 + 2 * i : ℕ) : ℝ)) =
      (Real.arctan (tj : ℝ) - (atTab j : ℝ)) +
      (Real.arctan (s : ℝ) - (s : ℝ) * ∑ i ∈ Finset.range n, (-((s : ℝ) ^ 2)) ^ i / ((1 + 2 * i : ℕ) : ℝ)) := by
    linarith [hadd]
  rw [e]
  have := abs_add_le (Real.arctan (tj : ℝ) - (atTab j : ℝ))
    (Real.arctan (s : ℝ) - (s : ℝ) * ∑ i ∈ Finset.range n, (-((s : ℝ) ^ 2)) ^ i / ((1 + 2 * i : ℕ) : ℝ))
  linarith [hT, hat, hmono]

def atanQ (n : ℕ) (t : ℚ) : Option (ℚ × ℚ) :=
  match atanPos n (qabs t) with
  | none => none
  | some (v, e) => some (if t < 0 then -v else v, e)

theorem atanQ_spec {n : ℕ} {t v e : ℚ} (h : atanQ n t = some (v, e)) :
    |Real.arctan (t : ℝ) - (v : ℝ)| ≤ (e : ℝ) := by
  unfold atanQ at h
  split at h
  · simp at h
  · rename_i v' e' hp
    simp only [Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    have hn0 : 0 ≤ qabs t := by rw [qabs_eq]; exact abs_nonneg _
    have h1 := atanPos_spec hn0 hp
    by_cases ht : t < 0
    · have hne : ((qabs t : ℚ) : ℝ) = -(t : ℝ) := by
        unfold qabs; rw [if_pos ht]; push_cast; ring
      rw [hne, Real.arctan_neg] at h1
      rw [if_pos ht]
      push_cast
      rw [← abs_neg]
      convert h1 using 2
      ring
    · have hne : ((qabs t : ℚ) : ℝ) = (t : ℝ) := by
        unfold qabs; rw [if_neg ht]
      rw [hne] at h1
      rw [if_neg ht]
      exact h1

theorem arg_of_octOK {a b : ℚ} {k : ℤ} (hk : octOK k (a, b) = true) (hkabs : |k| ≤ 4) :
    Complex.arg ⟨(a : ℝ), (b : ℝ)⟩ = (k : ℝ) * (Real.pi / 4) +
      Real.arctan ((((octRot k (a, b)).2 / (octRot k (a, b)).1 : ℚ)) : ℝ) := by
  unfold octOK at hk
  simp only [Bool.and_eq_true, decide_eq_true_eq, Bool.or_eq_true, bne_iff_ne, ne_eq] at hk
  obtain ⟨⟨⟨hr, hs⟩, h4⟩, hm4⟩ := hk
  set r := (octRot k (a, b)).1
  set s := (octRot k (a, b)).2
  have hrot := octRot_spec k (a, b)
  have := barrierComplexArg_octant_rational k ⟨(a : ℝ), (b : ℝ)⟩ (r : ℝ) (s : ℝ) hrot
    (by exact_mod_cast hr)
    (by have : 2 * |s| ≤ r := by rw [← qabs_eq]; exact hs
        have h' : ((2 * |s| : ℚ) : ℝ) ≤ (r : ℝ) := by exact_mod_cast this
        push_cast at h'
        linarith)
    hkabs
    (by intro hk4; rcases h4 with h4 | h4
        · exact absurd hk4 h4
        · exact_mod_cast h4)
    (by intro hk4; rcases hm4 with h4 | h4
        · exact absurd hk4 h4
        · exact_mod_cast h4)
  rw [this]
  push_cast
  rfl

/-- a guess of the octant from the signs and the ratio `|b|/|a|` (thresholds `2/5`, `5/2`) -/
def octGuess (a b : ℚ) : ℤ :=
  if 0 < a then
    (if 5 * qabs b ≤ 2 * a then 0 else if 2 * qabs b < 5 * a then (if 0 ≤ b then 1 else -1)
      else (if 0 ≤ b then 2 else -2))
  else
    (if 5 * qabs b ≤ 2 * qabs a then (if 0 ≤ b then 4 else -4)
      else if 2 * qabs b < 5 * qabs a then (if 0 ≤ b then 3 else -3)
      else (if 0 ≤ b then 2 else -2))

/-- the octant: the guess when it passes `octOK`, otherwise the search `findOct` -/
def findOctF (p : ℚ × ℚ) : Option ℤ :=
  let k := octGuess p.1 p.2
  if octOK k p = true ∧ |k| ≤ 4 then some k else findOct p

theorem findOctF_spec {p : ℚ × ℚ} {k : ℤ} (h : findOctF p = some k) :
    octOK k p = true ∧ |k| ≤ 4 := by
  unfold findOctF at h
  simp only at h
  split_ifs at h with hc
  · simp only [Option.some.injEq] at h
    subst h; exact hc
  · unfold findOct at h
    have hk' := List.find?_some h
    have hkmem := List.mem_of_find?_eq_some h
    refine ⟨hk', ?_⟩
    simp only [octCandidates, List.mem_cons, List.not_mem_nil, or_false] at hkmem
    rcases hkmem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> norm_num


/-! ### `pi/4` to `2^-125` (Machin) -/

def PI4 : ℚ := (PI4N : ℚ) / 2 ^ 128
def PI4E : ℚ := 1 / 2 ^ 125

theorem machin : 4 * Real.arctan (1 / 5) - Real.arctan (1 / 239) = Real.pi / 4 := by
  have h1 : Real.arctan (1 / 5) + Real.arctan (1 / 5) = Real.arctan (5 / 12) := by
    rw [Real.arctan_add (by norm_num)]; norm_num
  have h2 : Real.arctan (5 / 12) + Real.arctan (5 / 12) = Real.arctan (120 / 119) := by
    rw [Real.arctan_add (by norm_num)]; norm_num
  have h3 : Real.arctan (120 / 119) + Real.arctan (-(1 / 239)) = Real.arctan 1 := by
    rw [Real.arctan_add (by norm_num)]; norm_num
  rw [Real.arctan_neg, Real.arctan_one] at h3
  linarith

/-- the `arctan` series with a geometric tail, on a rational argument -/
theorem atanSer_spec {x : ℚ} (h0 : 0 ≤ x) (h1 : x < 1) (n : ℕ) :
    |Real.arctan (x : ℝ) - ((x * serH (-(x ^ 2)) n 1 : ℚ) : ℝ)| ≤
      (x : ℝ) ^ (2 * n + 1) / (1 - (x : ℝ) ^ 2) := by
  have hx0 : (0 : ℝ) ≤ x := by exact_mod_cast h0
  have hx1 : (x : ℝ) < 1 := by exact_mod_cast h1
  have ht := atan_tail hx0 hx1 n
  have hS := serH_spec (-(x ^ 2)) n 1
  have hsum : ((serH (-(x ^ 2)) n 1 : ℚ) : ℝ) =
      ∑ i ∈ Finset.range n, (-((x : ℝ) ^ 2)) ^ i / ((1 + 2 * i : ℕ) : ℝ) := by
    rw [hS]; push_cast; rfl
  push_cast
  rw [hsum]
  exact ht

def PIser : ℚ :=
  4 * ((1 / 5) * serH (-((1 / 5) ^ 2)) 30 1) - (1 / 239) * serH (-((1 / 239) ^ 2)) 9 1

def piChk : Bool := decide (qabs (PI4 - PIser) ≤ 1 / 2 ^ 128)

theorem piChk_true : piChk = true := by decide +kernel

theorem pi4_spec : |Real.pi / 4 - (PI4 : ℝ)| ≤ (PI4E : ℝ) := by
  have hc := piChk_true
  simp only [piChk, PIser, decide_eq_true_eq, qabs_eq] at hc
  have hc' := (Rat.cast_le (K := ℝ)).mpr hc
  have t5 := atanSer_spec (x := 1 / 5) (by norm_num) (by norm_num) 30
  have t239 := atanSer_spec (x := 1 / 239) (by norm_num) (by norm_num) 9
  have b5 : ((1 / 5 : ℚ) : ℝ) ^ (2 * 30 + 1) / (1 - ((1 / 5 : ℚ) : ℝ) ^ 2) ≤ 1 / 2 ^ 132 := by
    push_cast; norm_num
  have b239 : ((1 / 239 : ℚ) : ℝ) ^ (2 * 9 + 1) / (1 - ((1 / 239 : ℚ) : ℝ) ^ 2) ≤ 1 / 2 ^ 132 := by
    push_cast; norm_num
  have hm := machin
  push_cast at hc' t5 t239 b5 b239
  unfold PI4E
  push_cast
  rw [abs_le] at t5 t239 hc' ⊢
  constructor <;> nlinarith [t5.1, t5.2, t239.1, t239.2, hc'.1, hc'.2, b5, b239, hm]

/-- `Complex.arg (a + b i)` -/
def argQ (n : ℕ) (a b : ℚ) : Option (ℚ × ℚ) :=
  match findOctF (a, b) with
  | none => none
  | some k =>
    match atanQ n ((octRot k (a, b)).2 / (octRot k (a, b)).1) with
    | none => none
    | some (v, e) => some ((k : ℚ) * PI4 + v, qabs (k : ℚ) * PI4E + e)

theorem argQ_spec {n : ℕ} {a b v e : ℚ} (h : argQ n a b = some (v, e)) :
    |Complex.arg ⟨(a : ℝ), (b : ℝ)⟩ - (v : ℝ)| ≤ (e : ℝ) := by
  unfold argQ at h
  split at h
  · simp at h
  · rename_i k hk
    split at h
    · simp at h
    · rename_i v' e' hat
      simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      obtain ⟨hok, hkabs⟩ := findOctF_spec hk
      have harg := arg_of_octOK hok hkabs
      have h1 := atanQ_spec hat
      have h2 := pi4_spec
      rw [harg]
      have hqk : ((qabs (k : ℚ) : ℚ) : ℝ) = |(k : ℝ)| := by rw [qabs_eq]; push_cast; rfl
      have hc1 : (((k : ℚ) * PI4 + v' : ℚ) : ℝ) = (k : ℝ) * (PI4 : ℝ) + (v' : ℝ) := by push_cast; ring
      have hc2 : ((qabs (k : ℚ) * PI4E + e' : ℚ) : ℝ) = |(k : ℝ)| * (PI4E : ℝ) + (e' : ℝ) := by
        rw [Rat.cast_add, Rat.cast_mul, hqk]
      rw [hc1, hc2]
      have e : (k : ℝ) * (Real.pi / 4) + Real.arctan ((((octRot k (a, b)).2 / (octRot k (a, b)).1 : ℚ)) : ℝ) -
          ((k : ℝ) * (PI4 : ℝ) + (v' : ℝ)) =
          (k : ℝ) * (Real.pi / 4 - (PI4 : ℝ)) +
          (Real.arctan ((((octRot k (a, b)).2 / (octRot k (a, b)).1 : ℚ)) : ℝ) - (v' : ℝ)) := by ring
      rw [e]
      have t1 := abs_add_le ((k : ℝ) * (Real.pi / 4 - (PI4 : ℝ)))
        (Real.arctan ((((octRot k (a, b)).2 / (octRot k (a, b)).1 : ℚ)) : ℝ) - (v' : ℝ))
      have t2 : |(k : ℝ) * (Real.pi / 4 - (PI4 : ℝ))| ≤ |(k : ℝ)| * (PI4E : ℝ) := by
        rw [abs_mul]; exact mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
      linarith [t1, t2, h1]

theorem log_crude' {m : ℤ} {y : ℚ} (hy1 : 1 ≤ y) (hy2 : y ≤ 2) :
    |Real.log ((2 : ℝ) ^ m * (y : ℝ))| ≤ |(m : ℝ)| + 1 := by
  have hyR1 : (1 : ℝ) ≤ (y : ℝ) := by exact_mod_cast hy1
  have hyR2 : (y : ℝ) ≤ 2 := by exact_mod_cast hy2
  have hlogq : Real.log ((2 : ℝ) ^ m * (y : ℝ)) = (m : ℝ) * Real.log 2 + Real.log (y : ℝ) := by
    rw [Real.log_mul (by positivity) (by linarith), Real.log_zpow]
  have h2 := Real.log_two_lt_d9
  have h2p : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hl0 : 0 ≤ Real.log (y : ℝ) := Real.log_nonneg hyR1
  have hl1 : Real.log (y : ℝ) ≤ Real.log 2 := Real.log_le_log (by linarith) hyR2
  rw [hlogq]
  have habs : |(m : ℝ) * Real.log 2| ≤ |(m : ℝ)| := by
    rw [abs_mul, abs_of_pos h2p]
    have : Real.log 2 ≤ 1 := by norm_num at h2; linarith
    nlinarith [abs_nonneg (m : ℝ)]
  have t := abs_add_le ((m : ℝ) * Real.log 2) (Real.log (y : ℝ))
  rw [abs_of_nonneg hl0] at t
  norm_num at h2
  linarith


/-! ## 3. Enclosures, weighted logarithm terms, rounding to a dyadic grid -/

/-- `x` lies in the enclosure `(v, e)`. -/
def Enc (x : ℝ) (p : ℚ × ℚ) : Prop := |x - (p.1 : ℝ)| ≤ (p.2 : ℝ)

theorem Enc.add {x y : ℝ} {p q : ℚ × ℚ} (hx : Enc x p) (hy : Enc y q) :
    Enc (x + y) (p.1 + q.1, p.2 + q.2) := by
  unfold Enc at *
  push_cast
  rw [abs_le] at *
  constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

theorem Enc.sub {x y : ℝ} {p q : ℚ × ℚ} (hx : Enc x p) (hy : Enc y q) :
    Enc (x - y) (p.1 - q.1, p.2 + q.2) := by
  unfold Enc at *
  push_cast
  rw [abs_le] at *
  constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

theorem Enc.mulQ (w : ℚ) {x : ℝ} {p : ℚ × ℚ} (hx : Enc x p) :
    Enc ((w : ℝ) * x) (w * p.1, qabs w * p.2) := by
  unfold Enc at *
  push_cast
  have hw : ((qabs w : ℚ) : ℝ) = |(w : ℝ)| := by rw [qabs_eq]; push_cast; rfl
  rw [hw]
  have e : (w : ℝ) * x - (w : ℝ) * (p.1 : ℝ) = (w : ℝ) * (x - (p.1 : ℝ)) := by ring
  rw [e, abs_mul]
  exact mul_le_mul_of_nonneg_left hx (abs_nonneg _)

theorem Enc.const (c : ℚ) : Enc (c : ℝ) (c, 0) := by
  unfold Enc; simp

theorem Enc.mono {x : ℝ} {p : ℚ × ℚ} (hx : Enc x p) {e : ℚ} (h : p.2 ≤ e) : Enc x (p.1, e) := by
  unfold Enc at *
  have : (p.2 : ℝ) ≤ (e : ℝ) := by exact_mod_cast h
  exact hx.trans this

/-- the upper bound used as the anchor `A0 ≥ F(c)` of `TaylorCell.poleCellCheck_sound` -/
theorem Enc.le_upper {x : ℝ} {p : ℚ × ℚ} (hx : Enc x p) : x ≤ ((p.1 + p.2 : ℚ) : ℝ) := by
  unfold Enc at hx
  push_cast
  linarith [(abs_le.mp hx).2]

theorem Enc.ge_lower {x : ℝ} {p : ℚ × ℚ} (hx : Enc x p) : ((p.1 - p.2 : ℚ) : ℝ) ≤ x := by
  unfold Enc at hx
  push_cast
  linarith [(abs_le.mp hx).1]

/-- round down to the grid `2^-P` (integer arithmetic, as `encDiv`) -/
def dyRound (P : ℕ) (q : ℚ) : ℚ := ((q.num * 2 ^ P / (q.den : ℤ) : ℤ) : ℚ) / 2 ^ P

theorem dyRound_spec (P : ℕ) (q : ℚ) : 0 ≤ q - dyRound P q ∧ q - dyRound P q ≤ 1 / 2 ^ P := by
  unfold dyRound
  set k : ℤ := q.num * 2 ^ P / (q.den : ℤ) with hk
  set r : ℤ := q.num * 2 ^ P % (q.den : ℤ) with hr
  have hd : (0 : ℤ) < (q.den : ℤ) := by exact_mod_cast q.den_pos
  have h1 : (q.den : ℤ) * k + r = q.num * 2 ^ P := Int.mul_ediv_add_emod _ _
  have hr0 : 0 ≤ r := Int.emod_nonneg _ hd.ne'
  have hr1 : r < (q.den : ℤ) := Int.emod_lt_of_pos _ hd
  have h2 : (q.den : ℚ) * (k : ℚ) + (r : ℚ) = (q.num : ℚ) * 2 ^ P := by exact_mod_cast h1
  have hdq : (0 : ℚ) < (q.den : ℚ) := by exact_mod_cast q.den_pos
  have hr0q : (0 : ℚ) ≤ (r : ℚ) := by exact_mod_cast hr0
  have hr1q : (r : ℚ) < (q.den : ℚ) := by exact_mod_cast hr1
  have hq : q = (q.num : ℚ) / (q.den : ℚ) := (Rat.num_div_den q).symm
  have h2P : (0 : ℚ) < 2 ^ P := by positivity
  have hqd : q * (q.den : ℚ) = (q.num : ℚ) := Rat.mul_den_eq_num q
  have hk2 : (k : ℚ) / 2 ^ P * ((q.den : ℚ) * 2 ^ P) = (q.den : ℚ) * (k : ℚ) := by
    rw [div_mul_eq_mul_div, div_eq_iff h2P.ne']; ring
  have e : q - (k : ℚ) / 2 ^ P = (r : ℚ) / ((q.den : ℚ) * 2 ^ P) := by
    rw [eq_div_iff (by positivity)]
    have e1 : (q - (k : ℚ) / 2 ^ P) * ((q.den : ℚ) * 2 ^ P) =
        q * (q.den : ℚ) * 2 ^ P - (k : ℚ) / 2 ^ P * ((q.den : ℚ) * 2 ^ P) := by ring
    rw [e1, hk2, hqd]
    linarith [h2]
  rw [e]
  constructor
  · positivity
  · rw [div_le_div_iff₀ (by positivity) h2P]
    have := mul_le_mul_of_nonneg_right hr1q.le h2P.le
    linarith

theorem Enc.round (P : ℕ) {x : ℝ} {p : ℚ × ℚ} (hx : Enc x p) :
    Enc x (dyRound P p.1, p.2 + 1 / 2 ^ P) := by
  obtain ⟨h0, h1⟩ := dyRound_spec P p.1
  unfold Enc at *
  have h0r : (0 : ℝ) ≤ (p.1 : ℝ) - (dyRound P p.1 : ℝ) := by
    have := (Rat.cast_le (K := ℝ)).mpr h0
    push_cast at this
    exact this
  have h1r : (p.1 : ℝ) - (dyRound P p.1 : ℝ) ≤ 1 / 2 ^ P := by
    have := (Rat.cast_le (K := ℝ)).mpr h1
    push_cast at this
    exact this
  push_cast
  rw [abs_le] at *
  constructor <;> linarith [hx.1, hx.2]

/-- the sum of the rounded values with the accumulated error (every value rounded to `2^-P`) -/
def encSumRound (P : ℕ) : List (ℚ × ℚ) → ℚ × ℚ
  | [] => (0, 0)
  | p :: t => (dyRound P p.1 + (encSumRound P t).1, p.2 + 1 / 2 ^ P + (encSumRound P t).2)

theorem encSumRound_enc (P : ℕ) : ∀ (xs : List ℝ) (ps : List (ℚ × ℚ)),
    List.Forall₂ Enc xs ps → Enc xs.sum (encSumRound P ps)
  | [], [], _ => by unfold Enc; simp [encSumRound]
  | x :: xs, p :: ps, h => by
    obtain ⟨hx, hxs⟩ := List.forall₂_cons.mp h
    have := (hx.round P).add (encSumRound_enc P xs ps hxs)
    simpa [encSumRound, List.sum_cons] using this

/-! ### logarithms of rationals -/

/-- `Real.log q` for a rational `q > 0` -/
def logQ (n : ℕ) (q : ℚ) : Option (ℚ × ℚ) :=
  if 0 < q then
    match findExpY q with
    | none => none
    | some (m, y) => lnQy n y m
  else none

theorem logQ_spec {n : ℕ} {q v e : ℚ} (h : logQ n q = some (v, e)) :
    0 < q ∧ Enc (Real.log (q : ℝ)) (v, e) := by
  unfold logQ at h
  split_ifs at h with hq
  · split at h
    · simp at h
    · rename_i m y hmy
      obtain ⟨hyq, hy1, hy2⟩ := findExpY_spec hmy
      refine ⟨hq, ?_⟩
      have hqy : (q : ℝ) = (2 : ℝ) ^ m * (y : ℝ) := by
        have h0 := congrArg (fun t : ℚ => (t : ℝ)) hyq
        have h1 : (y : ℝ) = (q : ℝ) / (2 : ℝ) ^ m := by simpa using h0
        rw [h1]
        have : ((2 : ℝ) ^ m) ≠ 0 := by positivity
        field_simp
      unfold Enc
      rw [hqy]
      exact lnQy_spec hy1 hy2 h

/-- `Real.log |q|` for a rational `q ≠ 0` -/
def logAbsQ (n : ℕ) (q : ℚ) : Option (ℚ × ℚ) := logQ n (qabs q)

theorem logAbsQ_spec {n : ℕ} {q v e : ℚ} (h : logAbsQ n q = some (v, e)) :
    q ≠ 0 ∧ Enc (Real.log |(q : ℝ)|) (v, e) := by
  obtain ⟨h0, h1⟩ := logQ_spec h
  have hc : ((qabs q : ℚ) : ℝ) = |(q : ℝ)| := by rw [qabs_eq]; push_cast; rfl
  rw [hc] at h1
  refine ⟨?_, h1⟩
  intro hq
  rw [hq] at h0
  simp [qabs] at h0

/-- `w * log |x - p|` for rationals (the real poles and the explicit logarithms of the fields) -/
def realLogQ (n : ℕ) (w p x : ℚ) : Option (ℚ × ℚ) :=
  match logAbsQ n (x - p) with
  | none => none
  | some (l, el) => some (w * l, qabs w * el)

theorem realLogQ_spec {n : ℕ} {w p x : ℚ} {v e : ℚ} (h : realLogQ n w p x = some (v, e)) :
    x ≠ p ∧ Enc ((w : ℝ) * Real.log |(x : ℝ) - (p : ℝ)|) (v, e) := by
  unfold realLogQ at h
  split at h
  · simp at h
  · rename_i l el hl
    simp only [Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    obtain ⟨hne, hE⟩ := logAbsQ_spec hl
    refine ⟨fun hx => hne (by rw [hx]; ring), ?_⟩
    have := hE.mulQ w
    push_cast at this
    simpa using this

/-! ### real part of a weighted complex logarithm -/

/-- `Re[(rr + ri i) log (a + b i)]` -/
def reClogQ (nL nA : ℕ) (rr ri a b : ℚ) : Option (ℚ × ℚ) :=
  match logQ nL (a * a + b * b) with
  | none => none
  | some (l, el) =>
    if ri = 0 then some ((rr / 2) * l, qabs (rr / 2) * el)
    else
      match argQ nA a b with
      | none => none
      | some (ar, ea) => some ((rr / 2) * l - ri * ar, qabs (rr / 2) * el + qabs ri * ea)

theorem reClogQ_spec {nL nA : ℕ} {rr ri a b v e : ℚ} (h : reClogQ nL nA rr ri a b = some (v, e)) :
    0 < a * a + b * b ∧
      Enc (((⟨(rr : ℝ), (ri : ℝ)⟩ : ℂ) * Complex.log ⟨(a : ℝ), (b : ℝ)⟩).re) (v, e) := by
  unfold reClogQ at h
  split at h
  · simp at h
  · rename_i l el hl
    obtain ⟨hpos, hL⟩ := logQ_spec hl
    refine ⟨hpos, ?_⟩
    have hval : ((⟨(rr : ℝ), (ri : ℝ)⟩ : ℂ) * Complex.log ⟨(a : ℝ), (b : ℝ)⟩).re =
        (rr : ℝ) / 2 * Real.log ((a * a + b * b : ℚ) : ℝ) -
          (ri : ℝ) * Complex.arg ⟨(a : ℝ), (b : ℝ)⟩ := by
      rw [barrierComplexLog_weighted_re]
      push_cast
      ring_nf
    rw [hval]
    split_ifs at h with hri
    · simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h
      have hri0 : (ri : ℝ) = 0 := by exact_mod_cast hri
      rw [hri0, zero_mul, sub_zero]
      have := hL.mulQ (rr / 2)
      push_cast at this ⊢
      exact this
    · split at h
      · simp at h
      · rename_i ar ea hA
        simp only [Option.some.injEq, Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        have hAE : Enc (Complex.arg ⟨(a : ℝ), (b : ℝ)⟩) (ar, ea) := argQ_spec hA
        have := (hL.mulQ (rr / 2)).sub (hAE.mulQ ri)
        push_cast at this ⊢
        exact this

/-- the pole term `Re[ρ_q log (x - p_q)]` of the fields at a rational point `x` -/
def poleLogQ (nL nA : ℕ) (q : PoleR) (x : ℚ) : Option (ℚ × ℚ) :=
  reClogQ nL nA q.rr q.ri (x - q.pr) (-q.pi)

theorem poleLogQ_spec {nL nA : ℕ} {q : PoleR} {x v e : ℚ}
    (h : poleLogQ nL nA q x = some (v, e)) :
    Enc ((q.rho * Complex.log (((x : ℝ) : ℂ) - q.pc)).re) (v, e) := by
  obtain ⟨-, hE⟩ := reClogQ_spec h
  have hz : (((x : ℝ) : ℂ) - q.pc) = ⟨((x - q.pr : ℚ) : ℝ), ((-q.pi : ℚ) : ℝ)⟩ := by
    apply Complex.ext <;> simp [PoleR.pc]
  rw [hz]
  exact hE

/-- the anchor value of a field: the sum of the rounded term enclosures, an upper bound
`A0 = v + e` of `F(c)` (`Enc.le_upper`) -/
def anchorUB (P : ℕ) (ts : List (ℚ × ℚ)) : ℚ := (encSumRound P ts).1 + (encSumRound P ts).2

theorem anchorUB_spec (P : ℕ) {xs : List ℝ} {ts : List (ℚ × ℚ)} (h : List.Forall₂ Enc xs ts) :
    xs.sum ≤ ((anchorUB P ts : ℚ) : ℝ) :=
  (encSumRound_enc P xs ts h).le_upper

/-! ### regression: `log (3/2)` and `Re[i log (1+i)] = -pi/4` to 36 digits (the table precision is `2^-128`) -/

example : (match logQ 12 (3 / 2) with
    | some (v, e) => decide (e ≤ 1 / 2 ^ 120) &&
        decide (qabs (v - 405465108108164381978013115464349136571990423462494197614014 /
          10 ^ 60) ≤ 1 / 10 ^ 36)
    | none => false) = true := by decide +kernel

example : (match reClogQ 12 24 0 1 1 1 with
    | some (v, e) => decide (e ≤ 1 / 2 ^ 120) &&
        decide (qabs (v + 785398163397448309615660845819875721049292349843776455243736 /
          10 ^ 60) ≤ 1 / 10 ^ 36)
    | none => false) = true := by decide +kernel

/-! ## 4. Chaining: the value at the next centre from the Taylor expansion at the previous one -/

/-- `∑_{k=1}^{n} g k` -/
def tsum (g : ℕ → ℚ) : ℕ → ℚ
  | 0 => 0
  | n + 1 => tsum g n + g (n + 1)

theorem tsum_cast (g : ℕ → ℚ) : ∀ n, ((tsum g n : ℚ) : ℝ) = ∑ j ∈ Finset.range n, ((g (j + 1) : ℚ) : ℝ)
  | 0 => by simp [tsum]
  | n + 1 => by rw [tsum, Rat.cast_add, tsum_cast g n, Finset.sum_range_succ]

/-- The chained enclosure.  `m k ± ε k` encloses the Taylor coefficient `F^{(k)}(c)/k!`
(`1 ≤ k ≤ N`), `BM` bounds `|F^{(N+1)}|/(N+1)!` on the segment, `A` encloses `F(c)`, `h` is the
step: the result encloses `F(c + h)`. -/
def chainQ (m ε : ℕ → ℚ) (h : ℚ) (N : ℕ) (BM : ℚ) (A : ℚ × ℚ) : ℚ × ℚ :=
  (A.1 + tsum (fun k => m k * h ^ k) N,
    A.2 + tsum (fun k => ε k * qabs h ^ k) N + BM * qabs h ^ (N + 1))

open TaylorCell in
/-- **Chaining.**  For a derivative tower `f` on `[c - ρ, c + ρ]` with `|h| ≤ ρ`: an enclosure of
`f 0 c`, of the Taylor coefficients at `c` and a remainder bound on the segment give an enclosure
of `f 0 (c + h)`.  No logarithm is evaluated. -/
theorem chain_enc {f : ℕ → ℝ → ℝ} {c ρ : ℝ} {N : ℕ} (hf : IsTower f c ρ (N + 1)) (h : ℚ)
    (hh : |(h : ℝ)| ≤ ρ) (m ε : ℕ → ℚ) (BM : ℚ) (A : ℚ × ℚ) (hA : Enc (f 0 c) A)
    (hc : ∀ k, 1 ≤ k → k ≤ N → |f k c / ((Nat.factorial k : ℕ) : ℝ) - (m k : ℝ)| ≤ (ε k : ℝ))
    (hBM : ∀ y ∈ Set.Icc (c - ρ) (c + ρ), |f (N + 1) y| / ((Nat.factorial (N + 1) : ℕ) : ℝ) ≤ (BM : ℝ)) :
    Enc (f 0 (c + (h : ℝ))) (chainQ m ε h N BM A) := by
  have hρ : 0 ≤ ρ := (abs_nonneg _).trans hh
  have hx : c + (h : ℝ) ∈ Set.Icc (c - ρ) (c + ρ) :=
    ⟨by linarith [neg_abs_le (h : ℝ)], by linarith [le_abs_self (h : ℝ)]⟩
  have hfac : (0 : ℝ) < ((Nat.factorial (N + 1) : ℕ) : ℝ) := by positivity
  have hbd : ∀ y ∈ Set.Icc (c - ρ) (c + ρ), |f (N + 1) y| ≤ ((Nat.factorial (N + 1) : ℕ) : ℝ) * BM := by
    intro y hy
    have := hBM y hy
    rw [div_le_iff₀ hfac] at this
    linarith
  have htay := CatalanMeasure.CellCert.taylor_tower' c ρ (((Nat.factorial (N + 1) : ℕ) : ℝ) * BM) (N + 1) f hf.cont
    (fun j hj y hy => hf.der j hj y hy) hbd (c + (h : ℝ)) hx
  rw [add_sub_cancel_left, Finset.sum_range_succ'] at htay
  have hrem : ((Nat.factorial (N + 1) : ℕ) : ℝ) * BM * |(h : ℝ)| ^ (N + 1) / ((Nat.factorial (N + 1) : ℕ) : ℝ) =
      BM * |(h : ℝ)| ^ (N + 1) := by
    field_simp
  rw [hrem] at htay
  simp only [pow_zero, Nat.factorial_zero, Nat.cast_one, div_one, mul_one] at htay
  have hq : ((qabs h : ℚ) : ℝ) = |(h : ℝ)| := by rw [qabs_eq]; push_cast; rfl
  have hT : ((tsum (fun k => m k * h ^ k) N : ℚ) : ℝ) =
      ∑ j ∈ Finset.range N, (m (j + 1) : ℝ) * (h : ℝ) ^ (j + 1) := by
    rw [tsum_cast]; simp
  have hU : ((tsum (fun k => ε k * qabs h ^ k) N : ℚ) : ℝ) =
      ∑ j ∈ Finset.range N, (ε (j + 1) : ℝ) * |(h : ℝ)| ^ (j + 1) := by
    rw [tsum_cast]; simp [hq]
  have hS : ∑ j ∈ Finset.range N, f (j + 1) c * (h : ℝ) ^ (j + 1) / ((Nat.factorial (j + 1) : ℕ) : ℝ) =
      ∑ j ∈ Finset.range N, (f (j + 1) c / ((Nat.factorial (j + 1) : ℕ) : ℝ)) * (h : ℝ) ^ (j + 1) :=
    Finset.sum_congr rfl (fun j _ => by ring)
  have hD : ∑ j ∈ Finset.range N,
      ((f (j + 1) c / ((Nat.factorial (j + 1) : ℕ) : ℝ)) - (m (j + 1) : ℝ)) * (h : ℝ) ^ (j + 1) =
      ∑ j ∈ Finset.range N, (f (j + 1) c / ((Nat.factorial (j + 1) : ℕ) : ℝ)) * (h : ℝ) ^ (j + 1) -
        ∑ j ∈ Finset.range N, (m (j + 1) : ℝ) * (h : ℝ) ^ (j + 1) := by
    rw [← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl (fun j _ => by ring)
  have hDb : |∑ j ∈ Finset.range N,
      ((f (j + 1) c / ((Nat.factorial (j + 1) : ℕ) : ℝ)) - (m (j + 1) : ℝ)) * (h : ℝ) ^ (j + 1)| ≤
      ∑ j ∈ Finset.range N, (ε (j + 1) : ℝ) * |(h : ℝ)| ^ (j + 1) := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum (fun j hj => ?_))
    have hj' := Finset.mem_range.mp hj
    rw [abs_mul, abs_pow]
    exact mul_le_mul_of_nonneg_right (hc (j + 1) (by omega) (by omega)) (by positivity)
  unfold Enc chainQ at *
  push_cast
  rw [hT, hU]
  rw [hS] at htay
  have e : f 0 (c + (h : ℝ)) - ((A.1 : ℝ) + ∑ j ∈ Finset.range N, (m (j + 1) : ℝ) * (h : ℝ) ^ (j + 1)) =
      (f 0 (c + (h : ℝ)) - (∑ j ∈ Finset.range N, (f (j + 1) c / ((Nat.factorial (j + 1) : ℕ) : ℝ)) * (h : ℝ) ^ (j + 1)
        + f 0 c)) + (f 0 c - (A.1 : ℝ)) +
      ∑ j ∈ Finset.range N,
        ((f (j + 1) c / ((Nat.factorial (j + 1) : ℕ) : ℝ)) - (m (j + 1) : ℝ)) * (h : ℝ) ^ (j + 1) := by
    rw [hD]; ring
  rw [e]
  have t1 := abs_add_le (f 0 (c + (h : ℝ)) - (∑ j ∈ Finset.range N,
      (f (j + 1) c / ((Nat.factorial (j + 1) : ℕ) : ℝ)) * (h : ℝ) ^ (j + 1) + f 0 c)) (f 0 c - (A.1 : ℝ))
  have t2 := abs_add_le ((f 0 (c + (h : ℝ)) - (∑ j ∈ Finset.range N,
      (f (j + 1) c / ((Nat.factorial (j + 1) : ℕ) : ℝ)) * (h : ℝ) ^ (j + 1) + f 0 c)) + (f 0 c - (A.1 : ℝ)))
    (∑ j ∈ Finset.range N,
        ((f (j + 1) c / ((Nat.factorial (j + 1) : ℕ) : ℝ)) - (m (j + 1) : ℝ)) * (h : ℝ) ^ (j + 1))
  rw [hq]
  have hA' : |f 0 c - (A.1 : ℝ)| ≤ (A.2 : ℝ) := hA
  linarith [t1, t2, htay, hDb, hA']

open TaylorCell CatalanMeasure.CellCert in
/-- The chain step for a pole field `F' = Σ_q Re[ρ_q/(x - p_q)]`: the Taylor coefficients are the
exact `poleCoeff` (so `ε = 0`) and the remainder is `poleRemQ` on the segment `[c - |h|, c + |h|]`. -/
def poleChainQ (poles : List PoleR) (c h : ℚ) (N : ℕ) (A : ℚ × ℚ) : ℚ × ℚ :=
  chainQ (fun k => poleCoeff poles c k) (fun _ => 0) h N
    (poleRemQ poles (c - qabs' h) (c + qabs' h) (N + 1)) A

open TaylorCell CatalanMeasure.CellCert in
theorem poleChain_enc (poles : List PoleR) (F : ℝ → ℝ) (c h : ℚ) (N : ℕ) (A : ℚ × ℚ)
    (hdl : ∀ q ∈ poles, 0 < poleDist q (c - qabs' h) (c + qabs' h))
    (hF : ∀ x ∈ Set.Icc ((c : ℝ) - |(h : ℝ)|) ((c : ℝ) + |(h : ℝ)|),
      HasDerivAt F ((poles.map (fun q => qt q 0 x)).sum) x)
    (hA : Enc (F c) A) :
    Enc (F ((c : ℝ) + (h : ℝ))) (poleChainQ poles c h N A) := by
  have e1 : ((c - qabs' h : ℚ) : ℝ) = (c : ℝ) - |(h : ℝ)| := by push_cast; rw [qabs'_cast]
  have e2 : ((c + qabs' h : ℚ) : ℝ) = (c : ℝ) + |(h : ℝ)| := by push_cast; rw [qabs'_cast]
  have hne : ∀ y ∈ Set.Icc ((c : ℝ) - |(h : ℝ)|) ((c : ℝ) + |(h : ℝ)|), ∀ q ∈ poles,
      (y : ℂ) ≠ q.pc := by
    intro y hy q hq heq
    have := poleDist_le_norm q (c - qabs' h) (c + qabs' h) y (by rw [e1]; exact hy.1)
      (by rw [e2]; exact hy.2)
    rw [heq, sub_self, norm_zero] at this
    have h2 : (0 : ℝ) < ((poleDist q (c - qabs' h) (c + qabs' h) : ℚ) : ℝ) := by
      exact_mod_cast hdl q hq
    linarith
  have hT := isTower_poleTower poles F (c : ℝ) |(h : ℝ)| (N + 1) hne hF
  have := chain_enc hT h (le_refl _) (fun k => poleCoeff poles c k) (fun _ => 0)
    (poleRemQ poles (c - qabs' h) (c + qabs' h) (N + 1)) A (by simpa [poleTower_zero] using hA)
    (by
      intro k hk1 hkN
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      have := poleCoeff_spec poles F c k'
      rw [this]
      simp)
    (by
      intro y hy
      have := poleTower_rem poles F (c - qabs' h) (c + qabs' h) hdl N y (by rw [e1]; exact hy.1)
        (by rw [e2]; exact hy.2)
      exact this)
  unfold poleChainQ
  exact this

/-! ## 5. Dyadic normal form of literals, and rounding transfer -/

/-- A literal `m * 2^a / 2^b`: the mantissa `m` carries no 2-adic factor that is visible to the
kernel's 64-bit literal hash; the exponent pair is stored separately. -/
def dyVal (m : ℤ) (a b : ℕ) : ℚ := (m : ℚ) * 2 ^ a / 2 ^ b

/-- Moving a power of two from the numerator literal into an exponent: `n = m 2^a` with `a ≤ b`
gives `n / 2^b = m / 2^(b - a)` (rescaling a 2-adic literal table). -/
theorem dy_rescale {n m : ℤ} {a b : ℕ} (h : n = m * 2 ^ a) (hab : a ≤ b) :
    (n : ℚ) / 2 ^ b = (m : ℚ) / 2 ^ (b - a) := by
  have hb : (2 : ℚ) ^ b = 2 ^ a * 2 ^ (b - a) := by rw [← pow_add]; congr 1; omega
  rw [h, hb]
  push_cast
  field_simp

/-- The kernel-checked form of the rescaling: a Boolean test of `n = m 2^a`. -/
def dyRescaleOK (n m : ℤ) (a : ℕ) : Bool := decide (n = m * 2 ^ a)

theorem dy_rescale_of_ok {n m : ℤ} {a b : ℕ} (h : dyRescaleOK n m a = true) (hab : a ≤ b) :
    (n : ℚ) / 2 ^ b = (m : ℚ) / 2 ^ (b - a) :=
  dy_rescale (of_decide_eq_true h) hab

/-- A value rounded to the grid `2^-P` with numerator `k`, as a rational. -/
theorem dyRound_eq (P : ℕ) (q : ℚ) :
    dyRound P q = ((q.num * 2 ^ P / (q.den : ℤ) : ℤ) : ℚ) / 2 ^ P := rfl

/-- Rounding the coefficients of a polynomial (trial literals) to the grid changes its value on
`|x| ≤ r` by at most `Σ ε_k r^k`. -/
theorem round_poly_err (a a' ε : ℕ → ℝ) (n : ℕ) (x r : ℝ) (hx : |x| ≤ r)
    (hε : ∀ k < n, |a k - a' k| ≤ ε k) :
    |∑ k ∈ Finset.range n, a k * x ^ k - ∑ k ∈ Finset.range n, a' k * x ^ k| ≤
      ∑ k ∈ Finset.range n, ε k * r ^ k := by
  rw [← Finset.sum_sub_distrib]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum (fun k hk => ?_))
  have hk' := Finset.mem_range.mp hk
  rw [← sub_mul, abs_mul, abs_pow]
  exact mul_le_mul (hε k hk') (pow_le_pow_left₀ (abs_nonneg _) hx k) (by positivity)
    ((abs_nonneg _).trans (hε k hk'))

/-- Transfer of a one-sided bound across a rounded datum: if the rounded field satisfies
`G ≤ T` on the cell and the data differ by `δ`, the original satisfies `F ≤ T + δ`. -/
theorem round_transfer {F G : ℝ → ℝ} {S : Set ℝ} {T δ : ℝ} (hG : ∀ x ∈ S, G x ≤ T)
    (hd : ∀ x ∈ S, |F x - G x| ≤ δ) : ∀ x ∈ S, F x ≤ T + δ := by
  intro x hx
  have := (abs_le.mp (hd x hx)).2
  linarith [hG x hx]

