theorem nearLim_q (α β : ℚ) : ∀ x ∈ Ioo (0 : ℝ) 1, nearLim X2 α β x =
    fieldTower (fqN α β) (poleF (fqN α β).poles) 0 x + lfieldTower TsN 0 x + nearK T2.trial α β +
      (X2.CSP : ℝ) / 58 * (if 1 - 1 / 1024 < x then 1 else 0) := by
  intro x hx
  have h := hid_near T2.trial (fun y => (fval_rn (53 / 58) (24 / 29) y).symm) T2.aS_eq T2.rS_eq T2.bS_eq
    rfl T2.har (σ := 10 / 29) (α := α) (β := β) (csL := (X2.CSP : ℝ) / 58) (θL := 1 / 1024)
    (fq := fqN α β) rfl hx
  have hR : (fun y : ℝ => -((53 : ℝ) / 58) * Real.log (1 + y ^ 2) + (24 / 29) * Real.log |y|) =
      rnQ (53 / 58) (24 / 29) := by
    funext y; simp only [rnQ]; push_cast; ring
  have hσ : ((20 : ℝ) / 58) = ((10 / 29 : ℚ) : ℝ) := by push_cast; norm_num
  have e : nearLim X2 α β x = fNearMSLim T2.trial.form (rnQ (53 / 58) (24 / 29)) (α : ℝ) (β : ℝ)
      ((10 / 29 : ℚ) : ℝ) (fQ T2.bsL) T2.bsL.length ((X2.CSP : ℝ) / 58) (1 / 1024) x := by
    rw [← hσ, ← hR, ← bs_eq]
    rfl
  rw [e, h]
  rfl

/-- A near interior corner from its cell statement. -/
theorem corner (α β : ℚ) {a b : ℝ} (ha : ((α : ℚ) : ℝ) = a) (hb : ((β : ℚ) : ℝ) = b) (Fc : FieldQ) (T δ : ℚ) (hpl : (fqN α β).plogs = Fc.plogs) (hpo : (fqN α β).poles = Fc.poles)
    (hδ : l1Q (fqN α β).poly Fc.poly ≤ δ)
    (hs : ∀ x ∈ Icc (401 / 2500 : ℝ) (999 / 1000), fieldTower Fc (poleF Fc.poles) 0 x + lfieldTower TsN 0 x ≤ (T : ℝ)) :
    ∀ x ∈ Ico (401 / 2500 : ℝ) (999 / 1000), nearLim X2 a b x ≤ (T : ℝ) + δ + nearK T2.trial α β := by
  subst ha hb
  intro x hx
  have hx01 : x ∈ Ioo (0 : ℝ) 1 := ⟨by linarith [hx.1], by linarith [hx.2]⟩
  have hc := fieldTower_le_cell (fqN α β) Fc hpl hpo hδ (x := x)
    (by rw [abs_le]; constructor <;> linarith [hx01.1, hx01.2]) poleF
  have h1 := hs x ⟨hx.1, hx.2.le⟩
  have hsp : (if 1 - 1 / 1024 < x then (1 : ℝ) else 0) = 0 := if_neg (by linarith [hx.2])
  rw [nearLim_q α β x hx01, hsp]
  linarith

