module

public import Submission.CatalanMeasure.GenD.Signed.Data.Assembly.Curv
public import Submission.CatalanMeasure.GenD.Signed.Data.Consts.EvalRefMomMerge
public import Submission.CatalanMeasure.GenD.Signed.Data.Assembly.CurvFast
public import Submission.CatalanMeasure.GenD.Signed.Data.Assembly.Data
public import Submission.CatalanMeasure.GenD.Signed.Data.Consts.EvalRefE0
public import Submission.CatalanMeasure.GenD.Signed.Data.Consts.EvalRefE1
public import Submission.CatalanMeasure.GenD.Signed.Data.Consts.EvalRefE2
public import Submission.CatalanMeasure.GenD.Signed.Data.Consts.EvalRefX01
public import Submission.CatalanMeasure.GenD.Signed.Data.Consts.EvalRefX12

@[expose] public section

/-!
# 410 assembly: `κc` of the two α-intervals (generated by `phase2-data/consts/curv_emit.py`, bounds by `ivport.py`)

`kc01`, `kc12`: rational lower bounds of `curvQ (famD X0) (famD X1)` and `(X1, X2)`; the kernel checks `kc*_le`
compare them with the explicit combination of `famD_curv` (partial sums `K = 1000`, E1b enclosures, finite sums).
The long sums (`lbNorm`, `rbQ`, `ipDiffQ`) enter through rational bounds, each one declaration checked on the
fixed-point enclosures of `CurvFast` (`Cert.IvEval`); `kc*_le` itself is then arithmetic on short rationals.
-/

namespace CatalanMeasure.GenD.Signed.Data.Assembly

open Set Filter
open CatalanMeasure.Signed CatalanMeasure.Signed.Consts CatalanMeasure.GenD.Signed.Data.Trial
open CatalanMeasure.GenD.Signed.Data.Consts.EvalRef
open CatalanMeasure.GenD.Signed.Data.Consts.EvalRef.E0 (enL0 refEnergy_T0_ge)
open CatalanMeasure.GenD.Signed.Data.Consts.EvalRef.E1 (enL1 refEnergy_T1_ge)
open CatalanMeasure.GenD.Signed.Data.Consts.EvalRef.E2 (enL2 refEnergy_T2_ge)
open CatalanMeasure.GenD.Signed.Data.Consts.EvalRef.X01 (xU01 refBil_T01_le)
open CatalanMeasure.GenD.Signed.Data.Consts.EvalRef.X12 (xU12 refBil_T12_le)
open CatalanMeasure.Cert.Iv

set_option maxRecDepth 1000000
set_option Elab.async false

noncomputable section

def Ub00 : ℚ := ((38951328025083074663699 : ℚ) / 200000000000000000000000)

-- kcost: 400 steps x 20 poles of 3^81-scale integer ops, estimated 10 s
set_option profiler true in
theorem rb00_le : rbQ X0 X0 ≤ Ub00 := rbQ_le X0 X0 (by decide +kernel) _ (by decide +kernel)

def Ub11 : ℚ := ((96899502288942426946087 : ℚ) / 500000000000000000000000)

-- kcost: 400 steps x 20 poles of 3^81-scale integer ops, estimated 10 s
set_option profiler true in
theorem rb11_le : rbQ X1 X1 ≤ Ub11 := rbQ_le X1 X1 (by decide +kernel) _ (by decide +kernel)

def Ub22 : ℚ := ((22870111976029691479819 : ℚ) / 125000000000000000000000)

-- kcost: 400 steps x 20 poles of 3^81-scale integer ops, estimated 10 s
set_option profiler true in
theorem rb22_le : rbQ X2 X2 ≤ Ub22 := rbQ_le X2 X2 (by decide +kernel) _ (by decide +kernel)

def Lb01 : ℚ := ((607049652841186843247 : ℚ) / 3125000000000000000000)

-- kcost: 400 steps x 20 poles of 3^81-scale integer ops, estimated 10 s
set_option profiler true in
theorem rb01_ge : Lb01 ≤ rbQ X0 X1 := le_rbQ X0 X1 (by decide +kernel) _ (by decide +kernel)

def Lb10 : ℚ := ((48574608757598582697267 : ℚ) / 250000000000000000000000)

-- kcost: 400 steps x 20 poles of 3^81-scale integer ops, estimated 10 s
set_option profiler true in
theorem rb10_ge : Lb10 ≤ rbQ X1 X0 := le_rbQ X1 X0 (by decide +kernel) _ (by decide +kernel)

def Lb12 : ℚ := ((188010778200698670638821 : ℚ) / 1000000000000000000000000)

-- kcost: 400 steps x 20 poles of 3^81-scale integer ops, estimated 10 s
set_option profiler true in
theorem rb12_ge : Lb12 ≤ rbQ X1 X2 := le_rbQ X1 X2 (by decide +kernel) _ (by decide +kernel)

def Lb21 : ℚ := ((18857411367875813579973 : ℚ) / 100000000000000000000000)

-- kcost: 400 steps x 20 poles of 3^81-scale integer ops, estimated 10 s
set_option profiler true in
theorem rb21_ge : Lb21 ≤ rbQ X2 X1 := le_rbQ X2 X1 (by decide +kernel) _ (by decide +kernel)

def kc01 : ℚ := ((14003 : ℚ) / 1000000000)

def Lv01 : ℚ := ((7846193159555393417 : ℚ) / 250000000000000000000000)

def La01 : ℚ := ((710155874802121523 : ℚ) / 1000000000000000000000000)

def Lp01 : ℚ := ((1374891611587694631 : ℚ) / 1000000000000000000000000)

def Ui01 : ℚ := ((3124847330584210147 : ℚ) / 1000000000000000000000000)

-- kcost: 1000 steps, no poles (same tails), estimated 5 s
set_option profiler true in
theorem hv01 : Lv01 ≤ lbNorm X0.T.v X1.T.v 1000 := lbNorm_ge_same (by decide +kernel) 1000 _ (by decide +kernel)

-- kcost: 1000 steps x 40 poles of 3^81-scale integer ops, estimated 30 s
set_option profiler true in
theorem ha01 : La01 ≤ lbNorm X0.T.a X1.T.a 1000 :=
  lbNorm_ge (by decide +kernel) (by decide +kernel) 1000 _ (by decide +kernel)

-- kcost: 1000 steps, no poles (same tails), estimated 5 s
set_option profiler true in
theorem hp01 : Lp01 ≤ lbNorm X0.T.p X1.T.p 1000 := lbNorm_ge_same (by decide +kernel) 1000 _ (by decide +kernel)

-- kcost: 1000 moments x 25 coefficients of 3^81-scale integer ops, estimated 20 s
set_option profiler true in
set_option maxHeartbeats 4000000 in
theorem hi01 : ipDiffQ X0 X1 1000 ≤ Ui01 := by
  rw [show ipDiffQ X0 X1 1000 = ipDiffRQ (ofTrial X0.T) (ofTrial X1.T) 1000 from rfl,
    ipDiffRQ_merge (R := ofTrial X0.T) (S := ofTrial X1.T) merge0 merge1]
  exact ipDiffRQ_le rfl rfl rfl rfl 1000 _ (by decide +kernel)

-- kcost: short rationals plus the exact finite sums lbBQ (120 terms) and lbRRQ (400 terms), estimated 5 s
set_option profiler true in
theorem kc01_le : kc01 ≤ (1 / 2) * lbNorm X0.T.v X1.T.v 1000 + 2 * lbNorm X0.T.a X1.T.a 1000 + (1 - 9 / 20) * (enL0 + enL1 - 2 * xU01) + 2 * (9 / 20) * lbNorm X0.T.p X1.T.p 1000 - 2 * ubRaQ X0 X1 + lbBQ X0 X1 + (1 / 2) * lbRRQ X0 X1 - (1 / 2) * (ipDiffQ X0 X1 1000 + (2 * max X0.Cb X1.Cb) ^ 2 / ((1000 + 1) * (1000 + 2))) := by
  have key : kc01 ≤ (1 / 2) * Lv01 + 2 * La01 + (1 - 9 / 20) * (enL0 + enL1 - 2 * xU01) + 2 * (9 / 20) * Lp01 - 2 * (Ub00 - Lb01 - Lb10 + Ub11) + lbBQ X0 X1 + (1 / 2) * lbRRQ X0 X1 - (1 / 2) * (Ui01 + (2 * max X0.Cb X1.Cb) ^ 2 / ((1000 + 1) * (1000 + 2))) := by
    decide +kernel
  have hra : ubRaQ X0 X1 ≤ Ub00 - Lb01 - Lb10 + Ub11 := by
    unfold ubRaQ
    linarith [rb00_le, rb01_ge, rb10_ge, rb11_le]
  linarith [hv01, ha01, hp01, hi01]

theorem curv_ge_01 : ∀ᶠ N : ℕ in atTop, (kc01 : ℝ) ≤ curvQ (famD X0 N) (famD X1 N) (58 * N) := by
  have hokI : ∀ C : ℝ, (X0.Cb : ℝ) ≤ C → X0.T.DataOK C := fun C hC => T0.dataOK hC
  have hokJ : ∀ C : ℝ, (X1.Cb : ℝ) ≤ C → X1.T.DataOK C := fun C hC => T1.dataOK hC
  have hRB := famD_RB X0 X1 hokI hokJ
    (refEnergy_T0_ge (μ := famMu X0) ⟨rfl, rfl, rfl, rfl⟩ (ofTrial_OK (hokI _ le_rfl)))
    (refEnergy_T1_ge (μ := famMu X1) ⟨rfl, rfl, rfl, rfl⟩ (ofTrial_OK (hokJ _ le_rfl)))
    (refBil_T01_le (μ := famMu X0) (ν := famMu X1) ⟨rfl, rfl, rfl, rfl⟩ ⟨rfl, rfl, rfl, rfl⟩
      (ofTrial_OK (hokI _ le_rfl)) (ofTrial_OK (hokJ _ le_rfl)))
  have h := famD_curv X0 X1 hokI hokJ (by norm_num [X0, T0.Cb]) (by norm_num [X1, T1.Cb])
    (by decide +kernel) (by norm_num [X0, X1, T0.trial, T1.trial]) (by norm_num [X0, T0.trial]) 1000 _ hRB _
    (fun N => famD_IM X0 X1 hokI hokJ (by norm_num [X0, T0.Cb]) 1000 N)
  have hη : ((X0.T.η : ℚ) : ℝ) = 9 / 20 := by norm_num [X0, T0.trial]
  have hc := (Rat.cast_le (K := ℝ)).2 kc01_le
  filter_upwards [h] with N hN
  push_cast at hN hc
  rw [hη] at hN
  linarith

def kc12 : ℚ := ((181637 : ℚ) / 62500000)

def Lv12 : ℚ := ((2093255505669810552439 : ℚ) / 500000000000000000000000)

def La12 : ℚ := ((1495347998189813397 : ℚ) / 15625000000000000000000)

def Lp12 : ℚ := ((109568082388455809259 : ℚ) / 500000000000000000000000)

def Ui12 : ℚ := ((53073504527075639971 : ℚ) / 125000000000000000000000)

-- kcost: 1000 steps, no poles (same tails), estimated 5 s
set_option profiler true in
theorem hv12 : Lv12 ≤ lbNorm X1.T.v X2.T.v 1000 := lbNorm_ge_same (by decide +kernel) 1000 _ (by decide +kernel)

-- kcost: 1000 steps x 40 poles of 3^81-scale integer ops, estimated 30 s
set_option profiler true in
theorem ha12 : La12 ≤ lbNorm X1.T.a X2.T.a 1000 :=
  lbNorm_ge (by decide +kernel) (by decide +kernel) 1000 _ (by decide +kernel)

-- kcost: 1000 steps, no poles (same tails), estimated 5 s
set_option profiler true in
theorem hp12 : Lp12 ≤ lbNorm X1.T.p X2.T.p 1000 := lbNorm_ge_same (by decide +kernel) 1000 _ (by decide +kernel)

-- kcost: 1000 moments x 25 coefficients of 3^81-scale integer ops, estimated 20 s
set_option profiler true in
set_option maxHeartbeats 4000000 in
theorem hi12 : ipDiffQ X1 X2 1000 ≤ Ui12 := by
  rw [show ipDiffQ X1 X2 1000 = ipDiffRQ (ofTrial X1.T) (ofTrial X2.T) 1000 from rfl,
    ipDiffRQ_merge (R := ofTrial X1.T) (S := ofTrial X2.T) merge1 merge2]
  exact ipDiffRQ_le rfl rfl rfl rfl 1000 _ (by decide +kernel)

-- kcost: short rationals plus the exact finite sums lbBQ (120 terms) and lbRRQ (400 terms), estimated 5 s
set_option profiler true in
theorem kc12_le : kc12 ≤ (1 / 2) * lbNorm X1.T.v X2.T.v 1000 + 2 * lbNorm X1.T.a X2.T.a 1000 + (1 - 9 / 20) * (enL1 + enL2 - 2 * xU12) + 2 * (9 / 20) * lbNorm X1.T.p X2.T.p 1000 - 2 * ubRaQ X1 X2 + lbBQ X1 X2 + (1 / 2) * lbRRQ X1 X2 - (1 / 2) * (ipDiffQ X1 X2 1000 + (2 * max X1.Cb X2.Cb) ^ 2 / ((1000 + 1) * (1000 + 2))) := by
  have key : kc12 ≤ (1 / 2) * Lv12 + 2 * La12 + (1 - 9 / 20) * (enL1 + enL2 - 2 * xU12) + 2 * (9 / 20) * Lp12 - 2 * (Ub11 - Lb12 - Lb21 + Ub22) + lbBQ X1 X2 + (1 / 2) * lbRRQ X1 X2 - (1 / 2) * (Ui12 + (2 * max X1.Cb X2.Cb) ^ 2 / ((1000 + 1) * (1000 + 2))) := by
    decide +kernel
  have hra : ubRaQ X1 X2 ≤ Ub11 - Lb12 - Lb21 + Ub22 := by
    unfold ubRaQ
    linarith [rb11_le, rb12_ge, rb21_ge, rb22_le]
  linarith [hv12, ha12, hp12, hi12]

theorem curv_ge_12 : ∀ᶠ N : ℕ in atTop, (kc12 : ℝ) ≤ curvQ (famD X1 N) (famD X2 N) (58 * N) := by
  have hokI : ∀ C : ℝ, (X1.Cb : ℝ) ≤ C → X1.T.DataOK C := fun C hC => T1.dataOK hC
  have hokJ : ∀ C : ℝ, (X2.Cb : ℝ) ≤ C → X2.T.DataOK C := fun C hC => T2.dataOK hC
  have hRB := famD_RB X1 X2 hokI hokJ
    (refEnergy_T1_ge (μ := famMu X1) ⟨rfl, rfl, rfl, rfl⟩ (ofTrial_OK (hokI _ le_rfl)))
    (refEnergy_T2_ge (μ := famMu X2) ⟨rfl, rfl, rfl, rfl⟩ (ofTrial_OK (hokJ _ le_rfl)))
    (refBil_T12_le (μ := famMu X1) (ν := famMu X2) ⟨rfl, rfl, rfl, rfl⟩ ⟨rfl, rfl, rfl, rfl⟩
      (ofTrial_OK (hokI _ le_rfl)) (ofTrial_OK (hokJ _ le_rfl)))
  have h := famD_curv X1 X2 hokI hokJ (by norm_num [X1, T1.Cb]) (by norm_num [X2, T2.Cb])
    (by decide +kernel) (by norm_num [X1, X2, T1.trial, T2.trial]) (by norm_num [X1, T1.trial]) 1000 _ hRB _
    (fun N => famD_IM X1 X2 hokI hokJ (by norm_num [X1, T1.Cb]) 1000 N)
  have hη : ((X1.T.η : ℚ) : ℝ) = 9 / 20 := by norm_num [X1, T1.trial]
  have hc := (Rat.cast_le (K := ℝ)).2 kc12_le
  filter_upwards [h] with N hN
  push_cast at hN hc
  rw [hη] at hN
  linarith

end

end CatalanMeasure.GenD.Signed.Data.Assembly
