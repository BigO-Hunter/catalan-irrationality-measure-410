/-- **The S1 weight side.**  For every `w > 87.9662`: `hweights` for the gap nodes. -/
theorem s1_hweights {w : ℝ} (hw : (879662 / 10000 : ℝ) < w) :
    ∀ᶠ N : ℕ in atTop, ∀ (p m : ℕ), p + m = D58.Odd.design.n N →
      ∀ (k : ℕ), k < D58.Odd.design.n N → ∀ (j : Fin ((D58.Odd.design.n0 - D58.Odd.design.g0) * N)),
      |(rowCommonFactor D58.Odd.design N).eval (gapNodesD D58.Odd.design aGap N j)| *
        |restrictedWeight D58.Odd.design N k (gapNodesD D58.Odd.design aGap N) j| *
        (CatalanMeasure.binomBeta p m k : ℝ) ≤ 108000 * (N : ℝ) * Real.exp (w * N) := by
  refine s1_hweights_gen D58.Odd.design (by norm_num [D58.Odd.design]) (by norm_num [D58.Odd.design])
    (by norm_num [D58.Odd.design]) cells (PsiN : ℝ) aGap w aGap_pos aGap_lt_one aGap_ha4 contig
    (by simp [cells]) hrad hcirc hcell ?_
  have : (58 : ℝ) * (PsiN : ℝ) = 879662 / 10000 := by norm_num [PsiN]
  linarith only [this, hw]

/-- `w = 87.9663` (the value of `K590.rhoEnd_at_Psi0`). -/
theorem s1_hweights_Psi0 :
    ∀ᶠ N : ℕ in atTop, ∀ (p m : ℕ), p + m = D58.Odd.design.n N →
      ∀ (k : ℕ), k < D58.Odd.design.n N → ∀ (j : Fin ((D58.Odd.design.n0 - D58.Odd.design.g0) * N)),
      |(rowCommonFactor D58.Odd.design N).eval (gapNodesD D58.Odd.design aGap N j)| *
        |restrictedWeight D58.Odd.design N k (gapNodesD D58.Odd.design aGap N) j| *
        (CatalanMeasure.binomBeta p m k : ℝ) ≤ 108000 * (N : ℝ) * Real.exp ((879663 / 10000 : ℝ) * N) :=
  s1_hweights (by norm_num)

