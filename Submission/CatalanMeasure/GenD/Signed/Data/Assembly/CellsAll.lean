/-!
# `μ(G) ≤ 410`

The cell statements of the three trials (`cellsQ0`, `cellsQ1`, `cellsQ2`), each field the theorem exported by its
cell module, plugged into `catalan_irrationalityMeasure_410_of_cells`.
-/

namespace CatalanMeasure.GenD.Signed.Data.Assembly

open Set CatalanMeasure.CellCert CatalanMeasure.GenD.Signed.TaylorCell CatalanMeasure.GenD.Signed.Data.Cells
open CatalanMeasure.GenD.Signed.LogEval CatalanMeasure.GenD.Signed.Data.Trial

/-- The cell statements of trial 0. -/
theorem cellsQ0 : RowsQ0.CellsQ0 where
  sn := q0snSup
  snE := by
    unfold EndW
    have hE : q0snE096E = 0 := by decide +kernel
    refine ⟨q0snE096Blo, q0snE096TR, q0snE096U, 16, 16, ⟨by decide +kernel, by decide +kernel⟩, ?_, ?_, ?_⟩
    · intro x hx hx0
      have h := q0snE096Log x hx (by rw [hE]; exact hx0)
      rw [hE] at h
      exact h
    · have h := q0snE096End
      rw [hE] at h
      exact h
    · have h := q0snE096Cpos
      rw [hE] at h
      exact h
  sc := q0scSup
  scE := by
    unfold EndW
    have hE : q0scE040E = 1 := by decide +kernel
    refine ⟨q0scE040Blo, q0scE040TR, q0scE040U, 40, 40, ⟨by decide +kernel, by decide +kernel⟩, ?_, ?_, ?_⟩
    · intro x hx hx0
      have h := q0scE040Log x hx (by rw [hE]; exact hx0)
      rw [hE] at h
      exact h
    · have h := q0scE040End
      rw [hE] at h
      exact h
    · have h := q0scE040Cpos
      rw [hE] at h
      exact h
  sm := q0smSupIoc
  fr := q0frSup
  frLo := q0frE000Bound _ ⟨le_refl _, by exact_mod_cast (show q0frBd.getD 0 0 ≤ q0frE000Hi by decide +kernel)⟩
  frHi := q0frB044Bound _ ⟨by exact_mod_cast (show q0frB044Blo ≤ q0frBd.getD 45 0 by decide +kernel), le_refl _⟩
  spE0 := ⟨q0spe0TR, q0spe0U, q0spe0Log, by decide +kernel⟩
  spg := q0spiGapSup
  spi := q0spiSup
  spL1 := by
    have h := q0spL1Sup
    rw [show q0spL1B00Blo = 1 - 1 / 1024 by decide +kernel] at h
    exact h
  spE1 := by
    have hE : q0spL1EE = 1 := by decide +kernel
    have hB : q0spL1EBhi = 1 := by decide +kernel
    refine ⟨q0spL1EBlo, q0spL1EU, q0spL1ETR, 40, 40, by decide +kernel, by decide +kernel, by decide +kernel, ?_, ?_⟩
    · have h := q0spL1EEnd
      rw [hE, hB] at h
      exact h
    · have h := q0spL1EBound
      rw [hE, hB] at h
      exact h
  spmr_a := q0spmraSup
  spmt := q0spmtSup
  spmtL1 := by
    have h := q0spmtL1Sup
    rw [show q0spmtL1B00Blo = 1 - 1 / 1024 by decide +kernel] at h
    exact h
  near_zz := q0nearzzSup
  top_zz := ⟨q0nearzztSup, q0nearzztSupJ⟩
  near_az := q0nearazSup
  top_az := ⟨q0nearaztSup, q0nearaztSupJ⟩
  near_ah := q0nearahSup
  top_ah := ⟨q0nearahtSup, q0nearahtSupJ⟩

