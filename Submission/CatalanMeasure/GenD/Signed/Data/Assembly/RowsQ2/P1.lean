theorem hR4 {EBlo EU ETR T : ℚ} {k kR : ℕ} (hlo : q2spL1C - q2spL1Rho ≤ EBlo)
    (hend : endUOK q2spL1Fq [] 1 EBlo 1 k kR EU ETR T = true)
    (hreg : ∀ x ∈ Icc ((EBlo : ℚ) : ℝ) ((1 : ℚ) : ℝ),
      fieldTower (regQ q2spL1Fq 1) (poleF (regQ q2spL1Fq 1).poles) 0 x ≤ (ETR : ℝ)) :
    ∀ x ∈ Icc ((EBlo : ℚ) : ℝ) 1, x ≠ 1 →
      fieldTower q2spFq (poleF q2spFq.poles) 0 x + lfieldTower (dilTermsS T2.trial.qT T2.trial.qTn) 0 x ≤
        ((ETR + EU + (q2spL1Dl + l1Err q2spL1C q2spL1Rho 14 q2spL1Es) : ℚ) : ℝ) +
          ((endC q2spL1Fq [] 1 : ℚ) : ℝ) * Real.log |x - 1| := by
  intro x hx hx1
  have hlog := endOK_sound0 q2spL1Fq 1 EBlo 1 k EU ETR (endOK_of_endUOK hend) (by simpa using hreg)
  let S : Set ℝ := {y ∈ Icc ((EBlo : ℚ) : ℝ) ((1 : ℚ) : ℝ) | y ≠ 1}
  have hS : ∀ y ∈ S, ((q2spL1C : ℚ) : ℝ) - ((q2spL1Rho : ℚ) : ℝ) ≤ y ∧ y ≤ ((q2spL1C : ℚ) : ℝ) :=
    fun y hy => q2spL1Icc EBlo 1 hlo (by decide +kernel) y hy.1
  have key := l1_series_soundMG q2spFq q2spL1Fq q2spTs 8 q2spL1C q2spL1Rho 14 q2spL1Dl
    (fun y => (ETR : ℝ) + (EU : ℝ) + ((endC q2spL1Fq [] 1 : ℚ) : ℝ) * Real.log |y - ((1 : ℚ) : ℝ)|)
    q2spL1Logs q2spL1OK rfl rfl q2spL1D S hS (fun y hy => hlog y hy.1) x ⟨by simpa using hx, hx1⟩
  have e : q2spL1Es = l1EsOf 8 q2spTs := rfl
  rw [← e, q2spTs_eq] at key
  push_cast at key ⊢
  linarith

theorem log_le_neg {y : ℝ} {m : ℕ} (h0 : 0 < y) (h : y ≤ ((1 : ℝ) / 2) ^ m) :
    Real.log y ≤ -(69 / 100 * (m : ℝ)) := by
