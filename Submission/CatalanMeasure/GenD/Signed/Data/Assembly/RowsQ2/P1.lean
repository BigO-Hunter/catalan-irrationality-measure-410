  have h := hid_spm T2.trial (fun y => (fval_rm (53 / 58) y).symm) T2.pT_eq T2.aS_eq T2.rS_eq T2.bS_eq T2.rr_eq
    rfl T2.har (σ := 10 / 29) (rc := 11 / 8) (α := α) (csL := (X2.CSP : ℝ) / 58) (θL := 1 / 1024)
    (fq := fqB α) rfl hx
