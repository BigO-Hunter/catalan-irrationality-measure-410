namespace CatalanMeasure.GenD.Signed
open Filter

/-- **`μ(G) ≤ 410`**: for all large `b` and every integer `a`, `|G - a/b| > b^(-410)`. -/
theorem catalan_irrationalityMeasure_410 :
    ∀ᶠ b : ℕ in atTop, ∀ a : ℤ,
      (b : ℝ) ^ (-(410 : ℝ)) <
        |(∑' j : ℕ, (-1 : ℝ) ^ j / ((2 * j + 1 : ℕ) : ℝ) ^ 2) - a / b| :=
  catalan_irrationalityMeasure_410_of_cells Data.Assembly.cellsQ0 Data.Assembly.cellsQ1 Data.Assembly.cellsQ2

end CatalanMeasure.GenD.Signed
