    (by rw [show fqT.plogs = q2spmtFq.plogs from rfl]) (by rw [show fqT.poles = (fqB 0).poles from rfl, po_t]) l1_t
    (by rw [show fqT.plogs = q2spmtFq.plogs from rfl]) (by rw [show fqT.poles = (fqB 0).poles from rfl, po_t]) l1_t
    (xc := 999 / 1000) (m := 1 - 1 / 1024) (by norm_num) (by norm_num) rfl
    (by simpa using hT) (fun x hx => hJ x (by push_cast at hx ⊢; constructor <;> linarith [hx.1, hx.2]))
    (le_max_left _ _) (le_max_right _ _)
  intro ε hε
  filter_upwards [key ε hε] with N hN x hx hxc
  have h1 := hN x hx hxc
  have hK := spmK_le_2
  have hcs : (X2.CSP : ℝ) / 58 = ((X2.CSP / 58 : ℚ) : ℝ) := by push_cast; ring
  have hA := cast_le_of (show q2spmtT + (1 : ℚ) / 2 ^ 85 + Kup.spm2 ≤ (-127903819 / 134217728 : ℚ) by decide +kernel)
  have hB := cast_le_of (show q2spmtTJ + (1 : ℚ) / 2 ^ 85 + Kup.spm2 + X2.CSP / 58 ≤ (-127903819 / 134217728 : ℚ) by decide +kernel)
  rw [hcs] at h1
