  have hS2 : (q2spiT : ℝ) + (((1 : ℚ) / 2 ^ 85 : ℚ) : ℝ) + spK T2.trial ≤ (-917526653 / 536870912 : ℝ) := by
    have hS := cast_le_of (show q2spiT + (1 : ℚ) / 2 ^ 85 + Kup.sp2 ≤ (-917526653 / 536870912 : ℚ) by decide +kernel)
